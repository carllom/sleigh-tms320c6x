# TMS320C6000 compact (16-bit) instructions of header-based fetch packets
#
# The header's rs, dsz, br and sat fields (context) select register halves,
# load/store sizes, branch or .S forms and saturating forms. Compact registers
# are 3 bits wide and select A0-A7/B0-B7, or A16-A23/B16-B23 with rs set.

define token insn16(16)
	cs     = (0,0)
	c1_2   = (1,2)
	c3     = (3,3)
	c3_4   = (3,4)
	c4     = (4,4)
	c5     = (5,5)
	c5_6   = (5,6)
	c6_12  = (6,12) signed
	c6_13  = (6,13)
	c6_15  = (6,15) signed
	c0_12  = (0,12)
	c7     = (7,7)
	c7_9   = (7,9)
	c8     = (8,8)
	c9     = (9,9)
	c10    = (10,10)
	c10_13 = (10,13)
	c11    = (11,11)
	c11_12 = (11,12)
	c10_11h = (10,11)
	c13_15k = (13,15)
	c10_12h = (10,12)
	c8_9   = (8,9)
	c12    = (12,12)
	c13    = (13,13)
	c13_14 = (13,14)
	c13_15 = (13,15) dec
	c14    = (14,14)
	c14_15 = (14,15)
	c15    = (15,15)
	cbA    = (7,8)
	cbB    = (7,8)
	cd4A   = (4,4)
	cd4B   = (4,4)
	cd11A  = (11,11)
	cd11B  = (11,11)
	cpA0   = (5,6)
	cpA2   = (5,6)
	cpB0   = (5,6)
	cpB2   = (5,6)
	cpnA0  = (5,6)
	cpnA2  = (5,6)
	cpnB0  = (5,6)
	cpnB2  = (5,6)
	cmA0   = (10,11)
	cmA2   = (10,11)
	cmB0   = (10,11)
	cmB2   = (10,11)
	c15A   = (7,10)
	c15B   = (7,10)
	cppA   = (8,10)
	cppB   = (8,10)
	cppnA  = (8,10)
	cppnB  = (8,10)
	r4a0 = (4,6)
	r4b0 = (4,6)
	r4a1 = (4,6)
	r4b1 = (4,6)
	r4a2 = (4,6)
	r4b2 = (4,6)
	r4a3 = (4,6)
	r4b3 = (4,6)
	r7a0 = (7,9)
	r7b0 = (7,9)
	r7a1 = (7,9)
	r7b1 = (7,9)
	r7a2 = (7,9)
	r7b2 = (7,9)
	r7a3 = (7,9)
	r7b3 = (7,9)
	r13a0 = (13,15)
	r13b0 = (13,15)
	r13a1 = (13,15)
	r13b1 = (13,15)
	r13a2 = (13,15)
	r13b2 = (13,15)
	r13a3 = (13,15)
	r13b3 = (13,15)
;

attach variables [ r4a0 r7a0 r13a0 ] [ A0 A1 A2 A3 A4 A5 A6 A7 ];
attach variables [ r4b0 r7b0 r13b0 ] [ B0 B1 B2 B3 B4 B5 B6 B7 ];
attach variables [ r4a1 r7a1 r13a1 ] [ A8 A9 A10 A11 A12 A13 A14 A15 ];
attach variables [ r4b1 r7b1 r13b1 ] [ B8 B9 B10 B11 B12 B13 B14 B15 ];
attach variables [ r4a2 r7a2 r13a2 ] [ A16 A17 A18 A19 A20 A21 A22 A23 ];
attach variables [ r4b2 r7b2 r13b2 ] [ B16 B17 B18 B19 B20 B21 B22 B23 ];
attach variables [ r4a3 r7a3 r13a3 ] [ A24 A25 A26 A27 A28 A29 A30 A31 ];
attach variables [ r4b3 r7b3 r13b3 ] [ B24 B25 B26 B27 B28 B29 B30 B31 ];
attach variables [ cbA ] [ A4 A5 A6 A7 ];
attach variables [ cbB ] [ B4 B5 B6 B7 ];
attach variables [ cd4A cd11A ] [ A0 A1 ];
attach variables [ cd4B cd11B ] [ B0 B1 ];
attach variables [ cpA0 ] [ A1_A0 A3_A2 A5_A4 A7_A6 ];
attach variables [ cpA2 ] [ A17_A16 A19_A18 A21_A20 A23_A22 ];
attach variables [ cpB0 ] [ B1_B0 B3_B2 B5_B4 B7_B6 ];
attach variables [ cpB2 ] [ B17_B16 B19_B18 B21_B20 B23_B22 ];
attach names [ cpnA0 ] [ "A1:A0" "A3:A2" "A5:A4" "A7:A6" ];
attach names [ cpnA2 ] [ "A17:A16" "A19:A18" "A21:A20" "A23:A22" ];
attach names [ cpnB0 ] [ "B1:B0" "B3:B2" "B5:B4" "B7:B6" ];
attach names [ cpnB2 ] [ "B17:B16" "B19:B18" "B21:B20" "B23:B22" ];
attach variables [ cmA0 ] [ A0 A2 A4 A6 ];
attach variables [ cmA2 ] [ A16 A18 A20 A22 ];
attach variables [ cmB0 ] [ B0 B2 B4 B6 ];
attach variables [ cmB2 ] [ B16 B18 B20 B22 ];
attach variables [ c15A ] [ A0 A1 A2 A3 A4 A5 A6 A7 A8 A9 A10 A11 A12 A13 A14 A15 ];
attach variables [ c15B ] [ B0 B1 B2 B3 B4 B5 B6 B7 B8 B9 B10 B11 B12 B13 B14 B15 ];
attach variables [ cppA ] [ A1_A0 A3_A2 A5_A4 A7_A6 A9_A8 A11_A10 A13_A12 A15_A14 ];
attach variables [ cppB ] [ B1_B0 B3_B2 B5_B4 B7_B6 B9_B8 B11_B10 B13_B12 B15_B14 ];
attach names [ cppnA ] [ "A1:A0" "A3:A2" "A5:A4" "A7:A6" "A9:A8" "A11:A10" "A13:A12" "A15:A14" ];
attach names [ cppnB ] [ "B1:B0" "B3:B2" "B5:B4" "B7:B6" "B9:B8" "B11:B10" "B13:B12" "B15:B14" ];

cr4: r4a0 is cs=0 & rs=0 & r4a0 { export r4a0; }
cr4: r4a2 is cs=0 & rs=1 & r4a2 { export r4a2; }
cr4: r4b0 is cs=1 & rs=0 & r4b0 { export r4b0; }
cr4: r4b2 is cs=1 & rs=1 & r4b2 { export r4b2; }
cr7: r7a0 is cs=0 & rs=0 & r7a0 { export r7a0; }
cr7: r7a2 is cs=0 & rs=1 & r7a2 { export r7a2; }
cr7: r7b0 is cs=1 & rs=0 & r7b0 { export r7b0; }
cr7: r7b2 is cs=1 & rs=1 & r7b2 { export r7b2; }
cr13: r13a0 is cs=0 & rs=0 & r13a0 { export r13a0; }
cr13: r13a2 is cs=0 & rs=1 & r13a2 { export r13a2; }
cr13: r13b0 is cs=1 & rs=0 & r13b0 { export r13b0; }
cr13: r13b2 is cs=1 & rs=1 & r13b2 { export r13b2; }
cx7: r7a0 is ((cs=0 & c12=0) | (cs=1 & c12=1)) & rs=0 & r7a0 { export r7a0; }
cx7: r7a2 is ((cs=0 & c12=0) | (cs=1 & c12=1)) & rs=1 & r7a2 { export r7a2; }
cx7: r7b0 is ((cs=1 & c12=0) | (cs=0 & c12=1)) & rs=0 & r7b0 { export r7b0; }
cx7: r7b2 is ((cs=1 & c12=0) | (cs=0 & c12=1)) & rs=1 & r7b2 { export r7b2; }
ct4: r4a0 is c12=0 & rs=0 & r4a0 { export r4a0; }
ct4: r4a2 is c12=0 & rs=1 & r4a2 { export r4a2; }
ct4: r4b0 is c12=1 & rs=0 & r4b0 { export r4b0; }
ct4: r4b2 is c12=1 & rs=1 & r4b2 { export r4b2; }
cmv7: r7a0 is ((cs=0 & c12=0) | (cs=1 & c12=1)) & c10_11h=0 & r7a0 { export r7a0; }
cmv7: r7a1 is ((cs=0 & c12=0) | (cs=1 & c12=1)) & c10_11h=1 & r7a1 { export r7a1; }
cmv7: r7a2 is ((cs=0 & c12=0) | (cs=1 & c12=1)) & c10_11h=2 & r7a2 { export r7a2; }
cmv7: r7a3 is ((cs=0 & c12=0) | (cs=1 & c12=1)) & c10_11h=3 & r7a3 { export r7a3; }
cmv7: r7b0 is ((cs=1 & c12=0) | (cs=0 & c12=1)) & c10_11h=0 & r7b0 { export r7b0; }
cmv7: r7b1 is ((cs=1 & c12=0) | (cs=0 & c12=1)) & c10_11h=1 & r7b1 { export r7b1; }
cmv7: r7b2 is ((cs=1 & c12=0) | (cs=0 & c12=1)) & c10_11h=2 & r7b2 { export r7b2; }
cmv7: r7b3 is ((cs=1 & c12=0) | (cs=0 & c12=1)) & c10_11h=3 & r7b3 { export r7b3; }
cmv13: r13a0 is cs=0 & c10_11h=0 & r13a0 { export r13a0; }
cmv13: r13a1 is cs=0 & c10_11h=1 & r13a1 { export r13a1; }
cmv13: r13a2 is cs=0 & c10_11h=2 & r13a2 { export r13a2; }
cmv13: r13a3 is cs=0 & c10_11h=3 & r13a3 { export r13a3; }
cmv13: r13b0 is cs=1 & c10_11h=0 & r13b0 { export r13b0; }
cmv13: r13b1 is cs=1 & c10_11h=1 & r13b1 { export r13b1; }
cmv13: r13b2 is cs=1 & c10_11h=2 & r13b2 { export r13b2; }
cmv13: r13b3 is cs=1 & c10_11h=3 & r13b3 { export r13b3; }
cr7d: r7a0 is cs=0 & rs=0 & r7a0 { export r7a0; }
cr7d: r7a2 is cs=0 & rs=1 & r7a2 { export r7a2; }
cr7d: r7b0 is cs=1 & rs=0 & r7b0 { export r7b0; }
cr7d: r7b2 is cs=1 & rs=1 & r7b2 { export r7b2; }
cr13d: r13a0 is cs=0 & rs=0 & r13a0 { export r13a0; }
cr13d: r13a2 is cs=0 & rs=1 & r13a2 { export r13a2; }
cr13d: r13b0 is cs=1 & rs=0 & r13b0 { export r13b0; }
cr13d: r13b2 is cs=1 & rs=1 & r13b2 { export r13b2; }
cb: cbA is cs=0 & cbA { export cbA; }
cb: cbB is cs=1 & cbB { export cbB; }
cd4: cd4A is cs=0 & cd4A { export cd4A; }
cd4: cd4B is cs=1 & cd4B { export cd4B; }
cd11: cd11A is cs=0 & cd11A { export cd11A; }
cd11: cd11B is cs=1 & cd11B { export cd11B; }
ctp: cpnA0 is c12=0 & rs=0 & cpnA0 & cpA0 { export cpA0; }
ctp: cpnA2 is c12=0 & rs=1 & cpnA2 & cpA2 { export cpA2; }
ctp: cpnB0 is c12=1 & rs=0 & cpnB0 & cpB0 { export cpB0; }
ctp: cpnB2 is c12=1 & rs=1 & cpnB2 & cpB2 { export cpB2; }
cm10: cmA0 is cs=0 & rs=0 & cmA0 { export cmA0; }
cm10: cmA2 is cs=0 & rs=1 & cmA2 { export cmA2; }
cm10: cmB0 is cs=1 & rs=0 & cmB0 { export cmB0; }
cm10: cmB2 is cs=1 & rs=1 & cmB2 { export cmB2; }
c16: c15A is c12=0 & c15A { export c15A; }
c16: c15B is c12=1 & c15B { export c15B; }
c16p: cppnA is c12=0 & cppnA & cppA { export cppA; }
c16p: cppnB is c12=1 & cppnB & cppB { export cppB; }
cA0B0: "A0" is cs=0 { export A0; }
cA0B0: "B0" is cs=1 { export B0; }

cuL: ".L1" is cs=0 { }
cuL: ".L2" is cs=1 { }
cuLx: ".L1" is cs=0 & c12=0 { }
cuLx: ".L2" is cs=1 & c12=0 { }
cuLx: ".L1X" is cs=0 & c12=1 { }
cuLx: ".L2X" is cs=1 & c12=1 { }
cuSx: ".S1" is cs=0 & c12=0 { }
cuSx: ".S2" is cs=1 & c12=0 { }
cuSx: ".S1X" is cs=0 & c12=1 { }
cuSx: ".S2X" is cs=1 & c12=1 { }
cuMx: ".M1" is cs=0 & c12=0 { }
cuMx: ".M2" is cs=1 & c12=0 { }
cuMx: ".M1X" is cs=0 & c12=1 { }
cuMx: ".M2X" is cs=1 & c12=1 { }
cuDx: ".D1" is cs=0 & c12=0 { }
cuDx: ".D2" is cs=1 & c12=0 { }
cuDx: ".D1X" is cs=0 & c12=1 { }
cuDx: ".D2X" is cs=1 & c12=1 { }
cuD: ".D1" is cs=0 { }
cuD: ".D2" is cs=1 { }
cuDT: ".D1T1" is cs=0 & c12=0 { }
cuDT: ".D1T2" is cs=0 & c12=1 { }
cuDT: ".D2T1" is cs=1 & c12=0 { }
cuDT: ".D2T2" is cs=1 & c12=1 { }
cuD2T: ".D2T1" is c12=0 { }
cuD2T: ".D2T2" is c12=1 { }
cuD1X: ".D1X" is cs=0 { }
cuD1X: ".D2" is cs=1 { }
cuS1X: ".S1X" is cs=0 { }
cuS1X: ".S2" is cs=1 { }

# conditional compact branches test A0 or B0
ccz: "[A0] " is cs=0 & c4=0 { local c:1 = A0 != 0; export c; }
ccz: "[!A0] " is cs=0 & c4=1 { local c:1 = A0 == 0; export c; }
ccz: "[B0] " is cs=1 & c4=0 { local c:1 = B0 != 0; export c; }
ccz: "[!B0] " is cs=1 & c4=1 { local c:1 = B0 == 0; export c; }

cuS: ".S1" is cs=0 { }
cuS: ".S2" is cs=1 { }

# SSR bit of the compact instruction's unit
cssrL: is cs=0 { export 1:4; }
cssrL: is cs=1 { export 2:4; }
cssrS: is cs=0 { export 4:4; }
cssrS: is cs=1 { export 8:4; }

# compact branch targets, relative to the fetch packet
bs7: dest is c6_12 [ dest = (inst_start & 0xffffffe0) + (c6_12 << 1); ] { export *[ram]:4 dest; }
bu8: dest is c6_13 [ dest = (inst_start & 0xffffffe0) + (c6_13 << 1); ] { export *[ram]:4 dest; }
cs10: dest is c6_15 [ dest = (inst_start & 0xffffffe0) + (c6_15 << 2); ] { export *[ram]:4 dest; }

# Sbs7, Sbu8: BNOP
i16: "BNOP"^cuS bs7,c13_15 is c1_2=1 & c3=1 & br=1 & c5=0 & c4=0 & c14_15!=3 & cuS & bs7 & c6_12 & c13_15
	[ isbr = 1; dcnt = 6; dcall = 0; epx = c13_15; dkind = $(DK_JUMP); dtgt = (inst_start & 0xffffffe0) + (c6_12 << 1); ] { }
i16: "BNOP"^cuS bu8,"5" is c1_2=1 & c3=1 & br=1 & c5=0 & c4=0 & c14_15=3 & cuS & bu8 & c6_13
	[ isbr = 1; dcnt = 6; dcall = 0; epx = 5; dkind = $(DK_JUMP); dtgt = (inst_start & 0xffffffe0) + (c6_13 << 1); ] { }

# Scs10: CALLP
i16: "CALLP"^cuS cs10^",A3" is c1_2=1 & c3=1 & br=1 & c5=0 & c4=1 & cs=0 & cuS & cs10 & c6_15
	[ isbr = 1; dcnt = 6; dcall = 0; epx = 5; dkind = $(DK_CALLP_A3); dtgt = (inst_start & 0xffffffe0) + (c6_15 << 2); ] { }
i16: "CALLP"^cuS cs10^",B3" is c1_2=1 & c3=1 & br=1 & c5=0 & c4=1 & cs=1 & cuS & cs10 & c6_15
	[ isbr = 1; dcnt = 6; dcall = 0; epx = 5; dkind = $(DK_CALLP_B3); dtgt = (inst_start & 0xffffffe0) + (c6_15 << 2); ] { }

# Sbs7c, Sbu8c: conditional BNOP
i16: ^ccz^"BNOP"^cuS bs7,c13_15 is c1_2=1 & c3=1 & br=1 & c5=1 & c14_15!=3 & ccz & cuS & bs7 & c6_12 & c13_15
	[ isbr = 1; dcnt = 6; dcall = 0; epx = c13_15; dkind = $(DK_JUMP_C); dtgt = (inst_start & 0xffffffe0) + (c6_12 << 1); ] { BRC = ccz; }
i16: ^ccz^"BNOP"^cuS bu8,"5" is c1_2=1 & c3=1 & br=1 & c5=1 & c14_15=3 & ccz & cuS & bu8 & c6_13
	[ isbr = 1; dcnt = 6; dcall = 0; epx = 5; dkind = $(DK_JUMP_C); dtgt = (inst_start & 0xffffffe0) + (c6_13 << 1); ] { BRC = ccz; }

# Unop
i16: "NOP" nopn is c1_2=3 & c3_4=1 & c5_6=3 & c10_12h=3 & c13_15 [ nopn = c13_15 + 1; epx = c13_15; ] { }

################################################################
# .D loads and stores
################################################################

# address: Doff4 *ptr[ucst4], Dind *ptr[src1], Dinc *ptr++[ucst2], Ddec *--ptr[ucst2]
cma: "*"^cb^"["^off4^"]" is c10=0 & paren=0 & cb & c11 & c13_15 & asz [ off4 = (c11 << 3) | c13_15; ] { local ea:4 = cb + (off4 << asz); export ea; }
cma: "*"^cb^"("^off4^")" is c10=0 & paren=1 & cb & c11 & c13_15 [ off4 = (c11 << 3) | c13_15; ] { local ea:4 = cb + off4; export ea; }
cma: "*"^cb^"["^cr13^"]" is c10=1 & c11=0 & paren=0 & cb & cr13 & asz { local ea:4 = cb + (cr13 << asz); export ea; }
cma: "*"^cb^"("^cr13^")" is c10=1 & c11=0 & paren=1 & cb & cr13 { local ea:4 = cb + cr13; export ea; }
cma: "*"^cb^"++["^inc^"]" is c10=1 & c11=1 & c15=0 & c14=0 & cb & c13 & asz [ inc = c13 + 1; ] { local ea:4 = cb; cb = cb + (inc << asz); export ea; }
cma: "*--"^cb^"["^inc^"]" is c10=1 & c11=1 & c15=0 & c14=1 & cb & c13 & asz [ inc = c13 + 1; ] { cb = cb - (inc << asz); local ea:4 = cb; export ea; }

# Dstk: *B15[ucst5]
cstk: "*B15["^off5^"]" is c7_9 & c13_14 [ off5 = (c7_9 << 2) | c13_14; ] { local ea:4 = B15 + (off5 << 2); export ea; }

@define CD "c1_2=2 & (c10=0 | c11=0 | c15=0)"
@define CPROT "epx = epx | (prot << 2);"

# word or double word: the sz bit is clear, double word with dsz 1xx
i16: "LDW"^cuDT cma,ct4 is $(CD) & c3=1 & c9=0 & dsz<4 & cuDT & cma & ct4 [ asz = 2; $(CPROT) ] { ct4 = *:4 cma; }
i16: "STW"^cuDT ct4,cma is $(CD) & c3=0 & c9=0 & dsz<4 & cuDT & cma & ct4 [ asz = 2; ] { local v:4 = ct4; build cma; *:4 cma = v; }
i16: "LDDW"^cuDT cma,ctp is $(CD) & c3=1 & c9=0 & dsz>3 & c4=0 & cuDT & cma & ctp [ asz = 3; $(CPROT) ] { ctp = *:8 cma; }
i16: "STDW"^cuDT ctp,cma is $(CD) & c3=0 & c9=0 & dsz>3 & c4=0 & cuDT & cma & ctp [ asz = 3; ] { local v:8 = ctp; build cma; *:8 cma = v; }
i16: "LDNDW"^cuDT cma,ctp is $(CD) & c3=1 & c9=0 & dsz>3 & c4=1 & cuDT & cma & ctp [ asz = 3; paren = 1; $(CPROT) ] { ctp = *:8 cma; }
i16: "STNDW"^cuDT ctp,cma is $(CD) & c3=0 & c9=0 & dsz>3 & c4=1 & cuDT & cma & ctp [ asz = 3; paren = 1; ] { local v:8 = ctp; build cma; *:8 cma = v; }

# secondary size from dsz: BU B HU H W B NW H (loads), B B H H W B NW H (stores)
i16: "LDBU"^cuDT cma,ct4 is $(CD) & c3=1 & c9=1 & dsz=0 & cuDT & cma & ct4 [ asz = 0; $(CPROT) ] { ct4 = zext(*:1 cma); }
i16: "LDB"^cuDT cma,ct4 is $(CD) & c3=1 & c9=1 & (dsz=1 | dsz=5) & cuDT & cma & ct4 [ asz = 0; $(CPROT) ] { ct4 = sext(*:1 cma); }
i16: "LDHU"^cuDT cma,ct4 is $(CD) & c3=1 & c9=1 & dsz=2 & cuDT & cma & ct4 [ asz = 1; $(CPROT) ] { ct4 = zext(*:2 cma); }
i16: "LDH"^cuDT cma,ct4 is $(CD) & c3=1 & c9=1 & (dsz=3 | dsz=7) & cuDT & cma & ct4 [ asz = 1; $(CPROT) ] { ct4 = sext(*:2 cma); }
i16: "LDW"^cuDT cma,ct4 is $(CD) & c3=1 & c9=1 & dsz=4 & cuDT & cma & ct4 [ asz = 2; $(CPROT) ] { ct4 = *:4 cma; }
i16: "LDNW"^cuDT cma,ct4 is $(CD) & c3=1 & c9=1 & dsz=6 & cuDT & cma & ct4 [ asz = 2; $(CPROT) ] { ct4 = *:4 cma; }
i16: "STB"^cuDT ct4,cma is $(CD) & c3=0 & c9=1 & (dsz=0 | dsz=1 | dsz=5) & cuDT & cma & ct4 [ asz = 0; ] { local v:4 = ct4; build cma; *:1 cma = v:1; }
i16: "STH"^cuDT ct4,cma is $(CD) & c3=0 & c9=1 & (dsz=2 | dsz=3 | dsz=7) & cuDT & cma & ct4 [ asz = 1; ] { local v:4 = ct4; build cma; *:2 cma = v:2; }
i16: "STW"^cuDT ct4,cma is $(CD) & c3=0 & c9=1 & dsz=4 & cuDT & cma & ct4 [ asz = 2; ] { local v:4 = ct4; build cma; *:4 cma = v; }
i16: "STNW"^cuDT ct4,cma is $(CD) & c3=0 & c9=1 & dsz=6 & cuDT & cma & ct4 [ asz = 2; ] { local v:4 = ct4; build cma; *:4 cma = v; }

# Dstk
i16: "LDW"^cuDT cstk,ct4 is c1_2=2 & c10=1 & c11=1 & c15=1 & c3=1 & cuDT & cstk & ct4 [ $(CPROT) ] { ct4 = *:4 cstk; }
i16: "STW"^cuDT ct4,cstk is c1_2=2 & c10=1 & c11=1 & c15=1 & c3=0 & cuDT & cstk & ct4 { *:4 cstk = ct4; }


################################################################
# .L unit: L3, L3i, L2c
################################################################

i16: "ADD"^cuLx cr13,cx7,cr4 is c1_2=0 & c3=0 & c10=0 & c11=0 & sat=0 & cuLx & cr13 & cx7 & cr4 { cr4 = cr13 + cx7; }
i16: "SADD"^cuLx cr13,cx7,cr4 is c1_2=0 & c3=0 & c10=0 & c11=0 & sat=1 & cuLx & cr13 & cx7 & cr4 & cssrL { sadd32(cr13, cx7, cr4, cssrL); }
i16: "SUB"^cuLx cr13,cx7,cr4 is c1_2=0 & c3=0 & c10=0 & c11=1 & sat=0 & cuLx & cr13 & cx7 & cr4 { cr4 = cr13 - cx7; }
i16: "SSUB"^cuLx cr13,cx7,cr4 is c1_2=0 & c3=0 & c10=0 & c11=1 & sat=1 & cuLx & cr13 & cx7 & cr4 & cssrL { ssub32(cr13, cx7, cr4, cssrL); }
i16: "ADD"^cuLx cx7,c13_15,cr4 is c1_2=0 & c3=0 & c10=1 & c11=0 & c13_15k!=0 & cuLx & cx7 & c13_15 & cr4 { cr4 = cx7 + c13_15; }
i16: "ADD"^cuLx cx7,"8",cr4 is c1_2=0 & c3=0 & c10=1 & c11=0 & c13_15=0 & cuLx & cx7 & cr4 { cr4 = cx7 + 8; }
i16: "ADD"^cuLx cx7,n3,cr4 is c1_2=0 & c3=0 & c10=1 & c11=1 & cuLx & cx7 & c13_15 & cr4 [ n3 = c13_15 - 8; ] { cr4 = cx7 + n3; }

i16: "AND"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=0 & c5_6=0 & cuLx & cr13 & cx7 & cd4 { cd4 = cr13 & cx7; }
i16: "OR"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=0 & c5_6=1 & cuLx & cr13 & cx7 & cd4 { cd4 = cr13 | cx7; }
i16: "XOR"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=0 & c5_6=2 & cuLx & cr13 & cx7 & cd4 { cd4 = cr13 ^ cx7; }
i16: "CMPEQ"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=0 & c5_6=3 & cuLx & cr13 & cx7 & cd4 { cd4 = zext(cr13 == cx7); }
i16: "CMPLT"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=1 & c5_6=0 & cuLx & cr13 & cx7 & cd4 { cd4 = zext(cr13 s< cx7); }
i16: "CMPGT"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=1 & c5_6=1 & cuLx & cr13 & cx7 & cd4 { cd4 = zext(cr13 s> cx7); }
i16: "CMPLTU"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=1 & c5_6=2 & cuLx & cr13 & cx7 & cd4 { cd4 = zext(cr13 < cx7); }
i16: "CMPGTU"^cuLx cr13,cx7,cd4 is c1_2=0 & c3=1 & c10=1 & c11=1 & c5_6=3 & cuLx & cr13 & cx7 & cd4 { cd4 = zext(cr13 > cx7); }


################################################################
# .S unit: S3, S3i, Smvk8, Ssh5, S2sh, Sc5, S2ext
################################################################

i16: "ADD"^cuSx cr13,cx7,cr4 is c1_2=1 & c3=1 & br=0 & c10=0 & c11=0 & sat=0 & cuSx & cr13 & cx7 & cr4 { cr4 = cr13 + cx7; }
i16: "SADD"^cuSx cr13,cx7,cr4 is c1_2=1 & c3=1 & br=0 & c10=0 & c11=0 & sat=1 & cuSx & cr13 & cx7 & cr4 & cssrS { sadd32(cr13, cx7, cr4, cssrS); }
i16: "SUB"^cuSx cr13,cx7,cr4 is c1_2=1 & c3=1 & br=0 & c10=0 & c11=1 & cuSx & cr13 & cx7 & cr4 { cr4 = cr13 - cx7; }

# S3i shift counts: 16 1 2 3 4 5 6 8
s3i: c13_15 is c13_15 { export *[const]:4 c13_15; }
s3i: 16 is c13_15=0 { export 16:4; }
s3i: 8 is c13_15=7 { export 8:4; }
i16: "SHL"^cuSx cx7,s3i,cr4 is c1_2=1 & c3=1 & br=0 & c10=1 & c11=0 & cuSx & cx7 & s3i & cr4 { cr4 = cx7 << s3i; }
i16: "SHR"^cuSx cx7,s3i,cr4 is c1_2=1 & c3=1 & br=0 & c10=1 & c11=1 & cuSx & cx7 & s3i & cr4 { cr4 = cx7 s>> s3i; }

i16: "MVK"^cuS k8,cr7 is c1_2=1 & c3=0 & c4=1 & cuS & cr7 & c10 & c5_6 & c11_12 & c13_15
	[ k8 = (c10 << 7) | (c5_6 << 5) | (c11_12 << 3) | c13_15; ] { cr7 = k8; }

@define SC5 "c1_2=1 & c3=0 & c4=0"
u5: k5 is c11_12 & c13_15 [ k5 = (c11_12 << 3) | c13_15; ] { export *[const]:4 k5; }
u5d: k5 is c11_12 & c13_15 [ k5 = (c11_12 << 3) | c13_15; ] { export *[const]:4 k5; }

i16: "SHL"^cuS cr7,u5,cr7d is $(SC5) & c10=1 & c5_6=0 & cuS & cr7 & u5 & cr7d { cr7 = cr7 << u5; }
i16: "SHR"^cuS cr7,u5,cr7d is $(SC5) & c10=1 & c5_6=1 & cuS & cr7 & u5 & cr7d { cr7 = cr7 s>> u5; }
i16: "SHRU"^cuS cr7,u5,cr7d is $(SC5) & c10=1 & c5_6=2 & sat=0 & cuS & cr7 & u5 & cr7d { cr7 = cr7 >> u5; }
i16: "SSHL"^cuS cr7,u5,cr7d is $(SC5) & c10=1 & c5_6=2 & sat=1 & cuS & cr7 & u5 & cr7d & cssrS { sshl32(cr7, u5, cr7, cssrS); }
i16: "SHL"^cuS cr7,cr13,cr7d is $(SC5) & c10=1 & c5_6=3 & c11_12=0 & cuS & cr7 & cr13 & cr7d { cr7 = cr7 << (cr13 & 0x3f); }
i16: "SHR"^cuS cr7,cr13,cr7d is $(SC5) & c10=1 & c5_6=3 & c11_12=1 & cuS & cr7 & cr13 & cr7d { cr7 = cr7 s>> (cr13 & 0x3f); }
i16: "SHRU"^cuS cr7,cr13,cr7d is $(SC5) & c10=1 & c5_6=3 & c11_12=2 & cuS & cr7 & cr13 & cr7d { cr7 = cr7 >> (cr13 & 0x3f); }
i16: "SSHL"^cuS cr7,cr13,cr7d is $(SC5) & c10=1 & c5_6=3 & c11_12=3 & cuS & cr7 & cr13 & cr7d & cssrS { sshl32(cr7, cr13, cr7, cssrS); }

i16: "EXTU"^cuS cr7,u5,"31",cA0B0 is $(SC5) & c10=0 & c5_6=0 & cuS & cr7 & u5 & cA0B0 { cA0B0 = (cr7 << u5) >> 31; }
i16: "SET"^cuS cr7,u5,u5d,cr7d is $(SC5) & c10=0 & c5_6=1 & cuS & cr7 & u5 & u5d & cr7d { cr7 = cr7 | (1 << u5); }
i16: "CLR"^cuS cr7,u5,u5d,cr7d is $(SC5) & c10=0 & c5_6=2 & cuS & cr7 & u5 & u5d & cr7d { cr7 = cr7 & ~(1 << u5); }
i16: "EXT"^cuS cr7,"16","16",cr13 is $(SC5) & c10=0 & c5_6=3 & c11_12=0 & cuS & cr7 & cr13 { cr13 = (cr7 << 16) s>> 16; }
i16: "EXT"^cuS cr7,"24","24",cr13 is $(SC5) & c10=0 & c5_6=3 & c11_12=1 & cuS & cr7 & cr13 { cr13 = (cr7 << 24) s>> 24; }
i16: "EXTU"^cuS cr7,"16","16",cr13 is $(SC5) & c10=0 & c5_6=3 & c11_12=2 & cuS & cr7 & cr13 { cr13 = (cr7 << 16) >> 16; }
i16: "EXTU"^cuS cr7,"24","24",cr13 is $(SC5) & c10=0 & c5_6=3 & c11_12=3 & cuS & cr7 & cr13 { cr13 = (cr7 << 24) >> 24; }


################################################################
# .M unit: M3
################################################################

@define M3 "c1_2=3 & c3_4=3"
macro mpyhalves(dst, a, b, ah, bh) {
	local hx:4 = a >> (ah * 16);
	local hy:4 = b >> (bh * 16);
	local hx2:2 = hx:2;
	local hy2:2 = hy:2;
	dst = sext(hx2) * sext(hy2);
}
i16: "MPY"^cuMx cr13,cx7,cm10 is $(M3) & sat=0 & c5_6=0 & cuMx & cr13 & cx7 & cm10 { mpyhalves(cm10, cr13, cx7, 0, 0); }
i16: "MPYH"^cuMx cr13,cx7,cm10 is $(M3) & sat=0 & c5_6=1 & cuMx & cr13 & cx7 & cm10 { mpyhalves(cm10, cr13, cx7, 1, 1); }
i16: "MPYLH"^cuMx cr13,cx7,cm10 is $(M3) & sat=0 & c5_6=2 & cuMx & cr13 & cx7 & cm10 { mpyhalves(cm10, cr13, cx7, 0, 1); }
i16: "MPYHL"^cuMx cr13,cx7,cm10 is $(M3) & sat=0 & c5_6=3 & cuMx & cr13 & cx7 & cm10 { mpyhalves(cm10, cr13, cx7, 1, 0); }
i16: "SMPY"^cuMx cr13,cx7,cm10 is $(M3) & sat=1 & c5_6=0 & cuMx & cr13 & cx7 & cm10 { cm10 = _smpy(cr13, cx7); }
i16: "SMPYH"^cuMx cr13,cx7,cm10 is $(M3) & sat=1 & c5_6=1 & cuMx & cr13 & cx7 & cm10 { cm10 = _smpyh(cr13, cx7); }
i16: "SMPYLH"^cuMx cr13,cx7,cm10 is $(M3) & sat=1 & c5_6=2 & cuMx & cr13 & cx7 & cm10 { cm10 = _smpylh(cr13, cx7); }
i16: "SMPYHL"^cuMx cr13,cx7,cm10 is $(M3) & sat=1 & c5_6=3 & cuMx & cr13 & cx7 & cm10 { cm10 = _smpyhl(cr13, cx7); }


################################################################
# .L/.S/.D unit
################################################################

@define LSD "c1_2=3 & c3_4!=3"
cuLSDx: cuLx is c3_4=0 & cuLx { }
cuLSDx: cuSx is c3_4=1 & cuSx { }
cuLSDx: cuDx is c3_4=2 & cuDx { }
cuLSD: cuL is c3_4=0 & cuL { }
cuLSD: cuS is c3_4=1 & cuS { }
cuLSD: cuD is c3_4=2 & cuD { }

# LSDmvto, LSDmvfr
i16: "MV"^cuLSDx cmv7,cr13 is $(LSD) & c5_6=0 & cuLSDx & cmv7 & cr13 { cr13 = cmv7; }
i16: "MV"^cuLSDx cx7,cmv13 is $(LSD) & c5_6=2 & cuLSDx & cx7 & cmv13 { cmv13 = cx7; }

# Lx5, Lx3c, Lx1c
i16: "MVK"^cuL k5s,cr7 is c1_2=3 & c3_4=0 & c5_6=1 & c10=1 & cuL & cr7 & c11_12 & c13_15
	[ k5s = ((((c11_12 << 3) | c13_15) ^ 0x10) - 0x10); ] { cr7 = k5s; }
i16: "CMPEQ"^cuL c13_15,cr7,cd11 is c1_2=3 & c3_4=0 & c5_6=1 & c10=0 & c12=0 & cuL & c13_15 & cr7 & cd11 { cd11 = zext(cr7 == c13_15); }
i16: "CMPLT"^cuL c13,cr7,cd11 is c1_2=3 & c3_4=0 & c5_6=1 & c10=0 & c12=1 & c14_15=0 & cuL & c13 & cr7 & cd11 { cd11 = zext(c13 s< cr7); }
i16: "CMPGT"^cuL c13,cr7,cd11 is c1_2=3 & c3_4=0 & c5_6=1 & c10=0 & c12=1 & c14_15=1 & cuL & c13 & cr7 & cd11 { cd11 = zext(c13 s> cr7); }
i16: "CMPLTU"^cuL c13,cr7,cd11 is c1_2=3 & c3_4=0 & c5_6=1 & c10=0 & c12=1 & c14_15=2 & cuL & c13 & cr7 & cd11 { cd11 = zext(c13 < cr7); }
i16: "CMPGTU"^cuL c13,cr7,cd11 is c1_2=3 & c3_4=0 & c5_6=1 & c10=0 & c12=1 & c14_15=3 & cuL & c13 & cr7 & cd11 { cd11 = zext(c13 > cr7); }

# Sx2op, Sx5, Dx2op, Dx5
i16: "ADD"^cuSx cr13,cx7,cr13d is c1_2=3 & c3_4=1 & c5_6=1 & c10=0 & c11=0 & cuSx & cr13 & cx7 & cr13d { cr13 = cr13 + cx7; }
i16: "SUB"^cuSx cr13,cx7,cr13d is c1_2=3 & c3_4=1 & c5_6=1 & c10=0 & c11=1 & cuSx & cr13 & cx7 & cr13d { cr13 = cr13 - cx7; }
i16: "ADDK"^cuS u5,cr7 is c1_2=3 & c3_4=1 & c5_6=1 & c10=1 & cuS & u5 & cr7 { cr7 = cr7 + u5; }
i16: "ADD"^cuDx cr13,cx7,cr13d is c1_2=3 & c3_4=2 & c5_6=1 & c10=0 & c11=0 & cuDx & cr13 & cx7 & cr13d { cr13 = cr13 + cx7; }
i16: "SUB"^cuDx cr13,cx7,cr13d is c1_2=3 & c3_4=2 & c5_6=1 & c10=0 & c11=1 & cuDx & cr13 & cx7 & cr13d { cr13 = cr13 - cx7; }
i16: "ADDAW"^cuD1X "B15",u5,cr7 is c1_2=3 & c3_4=2 & c5_6=1 & c10=1 & cuD1X & u5 & cr7 { cr7 = B15 + (u5 << 2); }

# LSDx1 and the unit-specific Lx1, Sx1, Dx1
@define X1 "c1_2=3 & c3_4!=3 & c5_6=3 & c10_12h=6"
i16: "MVK"^cuLSD "0",cr7 is $(X1) & c13_15=0 & cuLSD & cr7 { cr7 = 0; }
i16: "MVK"^cuLSD "1",cr7 is $(X1) & c13_15=1 & cuLSD & cr7 { cr7 = 1; }
i16: "ADD"^cuLSD cr7,"1",cr7d is $(X1) & c13_15=5 & cuLSD & cr7 & cr7d { cr7 = cr7 + 1; }
i16: "XOR"^cuLSD cr7,"1",cr7d is $(X1) & c13_15=7 & cuLSD & cr7 & cr7d { cr7 = cr7 ^ 1; }
i16: "NEG"^cuLSD cr7,cr7d is $(X1) & c3_4!=2 & c13_15=2 & cuLSD & cr7 & cr7d { cr7 = -cr7; }
i16: "SUB"^cuL cr7,"1",cr7d is $(X1) & c3_4=0 & c13_15=3 & cuL & cr7 & cr7d { cr7 = cr7 - 1; }
i16: "SUB"^cuS cr7,"1",cr7d is $(X1) & c3_4=1 & c13_15=3 & cuS & cr7 & cr7d { cr7 = cr7 - 1; }
cb7: r7b0 is rs=0 & r7b0 { export r7b0; }
cb7: r7b2 is rs=1 & r7b2 { export r7b2; }
i16: "MVC"^cuS cb7,"ILC" is $(X1) & c3_4=1 & c13_15=6 & cuS & cb7 { ILC = cb7; }
i16: "SUB"^cuLSD cr7,"1",cr7d is $(X1) & c3_4=2 & c13_15=3 & cuLSD & cr7 & cr7d { cr7 = cr7 - 1; }

# LSDx1c: MVK on A0 or B0
x1c: "[A0] " is c14_15=0 { local c:1 = A0 != 0; export c; }
x1c: "[!A0] " is c14_15=1 { local c:1 = A0 == 0; export c; }
x1c: "[B0] " is c14_15=2 { local c:1 = B0 != 0; export c; }
x1c: "[!B0] " is c14_15=3 { local c:1 = B0 == 0; export c; }
i16: ^x1c^"MVK"^cuLSD c13,cr7 is $(LSD) & c5_6=3 & c10_12h=2 & x1c & cuLSD & c13 & cr7
{
	if (x1c == 0) goto <skp>;
	cr7 = c13;
<skp>
}

# loop buffer instructions in the .L space
@define LB "c1_2=3 & c3_4=0 & c5_6=3"
i16: "SPLOOP" ii4 is $(LB) & c10_13=3 & c15=0 & cs=0 & c14 & c7_9 [ ii4 = ((c14 << 3) | c7_9) + 1; spii = (c14 << 3) | c7_9; globalset(inst_next, spii); ] { sploop(ii4:1); }
i16: "SPLOOPD" ii4 is $(LB) & c10_13=3 & c15=0 & cs=1 & c14 & c7_9 [ ii4 = ((c14 << 3) | c7_9) + 1; spii = (c14 << 3) | c7_9; globalset(inst_next, spii); ] { sploopd(ii4:1); }
i16: "[A0] SPLOOPD" ii4 is $(LB) & c10_13=3 & c15=1 & cs=0 & c14 & c7_9 [ ii4 = ((c14 << 3) | c7_9) + 1; spii = (c14 << 3) | c7_9; globalset(inst_next, spii); ] { sploopd(ii4:1); }
i16: "[B0] SPLOOPD" ii4 is $(LB) & c10_13=3 & c15=1 & cs=1 & c14 & c7_9 [ ii4 = ((c14 << 3) | c7_9) + 1; spii = (c14 << 3) | c7_9; globalset(inst_next, spii); ] { sploopd(ii4:1); }
i16: "SPKERNEL" spkd is $(LB) & c10_13=7 & cs & c14_15 & c7_9 & spkd [ spkv = (cs << 5) | (c14_15 << 3) | c7_9; ] { spkernel(spkd); }
i16: "SPMASK" spml is $(LB) & c10_13=0xb & cs & c7 & c8 & c9 & c14 & c15 & spml
	[ spmv = cs | (c7 << 1) | (c8 << 2) | (c9 << 3) | (c14 << 4) | (c15 << 5); ] { spmask(spml); }
i16: "SPMASKR" spml is $(LB) & c10_13=0xf & cs & c7 & c8 & c9 & c14 & c15 & spml
	[ spmv = cs | (c7 << 1) | (c8 << 2) | (c9 << 3) | (c14 << 4) | (c15 << 5); ] { spmaskr(spml); }

# Sx1b: BNOP to B0-B15
cb16: c15B is c15B { export c15B; }
i16: "BNOP"^cuS cb16,c13_15 is c1_2=3 & c3_4=1 & c5_6=3 & c11_12=0 & cuS & cb16 & c13_15
	[ isbr = 1; dcnt = 6; dcall = 0; epx = c13_15; dkind = $(DK_JUMPR); ] { BRT = cb16; }
i16: "BNOP"^cuS cb16,c13_15 is c1_2=3 & c3_4=1 & c5_6=3 & c11_12=0 & c7_9=3 & c10=0 & cuS & cb16 & c13_15
	[ isbr = 1; dcnt = 6; dcall = 0; epx = c13_15; dkind = $(DK_RET); ] { BRT = cb16; }

# Dpp: push and pop on B15
cpt: "1" is c12=0 { }
cpt: "2" is c12=1 { }
i16: "STW"^cuD^"T"^cpt c16,"*B15--["^inc^"]" is c1_2=3 & c3_4=2 & c5_6=3 & c11=0 & c15=0 & c14=0 & cuD & cpt & c16 & c13 [ inc = c13 + 1; ]
	{ local v:4 = c16; *:4 B15 = v; B15 = B15 - (inc << 2); }
i16: "LDW"^cuD^"T"^cpt "*++B15["^inc^"]",c16 is c1_2=3 & c3_4=2 & c5_6=3 & c11=0 & c15=0 & c14=1 & cuD & cpt & c16 & c13 [ inc = c13 + 1; $(CPROT) ]
	{ B15 = B15 + (inc << 2); c16 = *:4 B15; }
i16: "STDW"^cuD^"T"^cpt c16p,"*B15--["^inc^"]" is c1_2=3 & c3_4=2 & c5_6=3 & c11=0 & c15=1 & c14=0 & cuD & cpt & c16p & c13 [ inc = c13 + 1; ]
	{ local v:8 = c16p; *:8 B15 = v; B15 = B15 - (inc << 3); }
i16: "LDDW"^cuD^"T"^cpt "*++B15["^inc^"]",c16p is c1_2=3 & c3_4=2 & c5_6=3 & c11=0 & c15=1 & c14=1 & cuD & cpt & c16p & c13 [ inc = c13 + 1; $(CPROT) ]
	{ B15 = B15 + (inc << 3); c16p = *:8 B15; }

# Dx5p: ADDAW/SUBAW on B15
i16: "ADDAW"^cuD "B15",k5p,"B15" is c1_2=3 & c3_4=2 & c5_6=3 & c10_12h=3 & c7=0 & cuD & c8_9 & c13_15 [ k5p = (c8_9 << 3) | c13_15; ] { B15 = B15 + (k5p << 2); }
i16: "SUBAW"^cuD "B15",k5p,"B15" is c1_2=3 & c3_4=2 & c5_6=3 & c10_12h=3 & c7=1 & cuD & c8_9 & c13_15 [ k5p = (c8_9 << 3) | c13_15; ] { B15 = B15 - (k5p << 2); }
