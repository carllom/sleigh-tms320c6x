i32: ^cc^"DOTPRSU2"^uM r1,xr2,rd is $(MXU) & op6_10=0x0d & cc & uM & r1 & xr2 & rd { rd = _dotprsu2(r1, xr2); }
i32: ^cc^"DOTPSU4"^uM r1,xr2,rd is $(MXU) & op6_10=0x02 & cc & uM & r1 & xr2 & rd { rd = _dotpsu4(r1, xr2); }
i32: ^cc^"DOTPU4"^uM r1,xr2,rd is $(MXU) & op6_10=0x06 & cc & uM & r1 & xr2 & rd { rd = _dotpu4(r1, xr2); }
i32: ^cc^"GMPY4"^uM r1,xr2,rd is $(MXU) & op6_10=0x11 & cc & uM & r1 & xr2 & rd { rd = _gmpy4(r1, xr2); }
i32: ^cc^"MPYHI"^uM r1,xr2,pd is $(MXU) & op6_10=0x14 & cc & uM & r1 & xr2 & pd { local xaw:4 = r1 >> 16; local xah:2 = xaw:2; local xa:4 = sext(xah); pd = sext(xa) * sext(xr2); }
i32: ^cc^"MPYHIR"^uM r1,xr2,rd is $(MXU) & op6_10=0x10 & cc & uM & r1 & xr2 & rd { rd = _mpyhir(r1, xr2); }
i32: ^cc^"MPYLI"^uM r1,xr2,pd is $(MXU) & op6_10=0x15 & cc & uM & r1 & xr2 & pd { local xah:2 = r1:2; local xa:4 = sext(xah); pd = sext(xa) * sext(xr2); }
i32: ^cc^"MPYLIR"^uM r1,xr2,rd is $(MXU) & op6_10=0x0e & cc & uM & r1 & xr2 & rd { rd = _mpylir(r1, xr2); }
i32: ^cc^"MPYSPDP"^uM r1,xp2,pd is $(MXU) & op6_10=0x16 & cc & uM & r1 & xp2 & pd { local fa:8 = float2float(r1); pd = fa f* xp2; }
i32: ^cc^"MPYSP2DP"^uM r1,xr2,pd is $(MXU) & op6_10=0x17 & cc & uM & r1 & xr2 & pd { local fa:8 = float2float(r1); local fb:8 = float2float(xr2); pd = fa f* fb; }
i32: ^cc^"MPYSU4"^uM r1,xr2,pd is $(MXU) & op6_10=0x05 & cc & uM & r1 & xr2 & pd { pd = _mpysu4(r1, xr2); }
i32: ^cc^"MPYU4"^uM r1,xr2,pd is $(MXU) & op6_10=0x04 & cc & uM & r1 & xr2 & pd { pd = _mpyu4(r1, xr2); }
i32: ^cc^"MPY2"^uM r1,xr2,pd is $(MXU) & op6_10=0x00 & cc & uM & r1 & xr2 & pd { pd = _mpy2(r1, xr2); }
i32: ^cc^"MPY32U"^uM r1,xr2,pd is $(MXU) & op6_10=0x18 & cc & uM & r1 & xr2 & pd { pd = zext(r1) * zext(xr2); }
i32: ^cc^"MPY32US"^uM r1,xr2,pd is $(MXU) & op6_10=0x19 & cc & uM & r1 & xr2 & pd { pd = zext(r1) * sext(xr2); }
i32: ^cc^"SMPY2"^uM r1,xr2,pd is $(MXU) & op6_10=0x01 & cc & uM & r1 & xr2 & pd { pd = _smpy2(r1, xr2); }
i32: ^cc^"SSHVL"^uM xr2,r1,rd is $(MXU) & op6_10=0x1c & cc & uM & xr2 & r1 & rd & ssrM { sshvl32(xr2, r1, rd, ssrM); }
i32: ^cc^"SSHVR"^uM xr2,r1,rd is $(MXU) & op6_10=0x1a & cc & uM & xr2 & r1 & rd { rd = _sshvr(xr2, r1); }
i32: ^cc^"ROTL"^uM xr2,r1,rd is $(MXU) & op6_10=0x1d & cc & uM & xr2 & r1 & rd { local n:4 = r1 & 31; rd = (xr2 << n) | (xr2 >> ((32 - n) & 31)); }
i32: ^cc^"ROTL"^uM xr2,uc5,rd is $(MXU) & op6_10=0x1e & cc & uM & xr2 & uc5 & rd { local n:4 = uc5 & 31; rd = (xr2 << n) | (xr2 >> ((32 - n) & 31)); }

################################################################
# .M unit, extended nonconditional
################################################################

i32: "CMPY"^uM r1,xr2,pd is $(MXU) & op6_10=0x0a & cz=1 & uM & r1 & xr2 & pd { pd = _cmpy(r1, xr2); }
i32: "CMPYR"^uM r1,xr2,rd is $(MXU) & op6_10=0x0b & cz=1 & uM & r1 & xr2 & rd { rd = _cmpyr(r1, xr2); }
i32: "CMPYR1"^uM r1,xr2,rd is $(MXU) & op6_10=0x0c & cz=1 & uM & r1 & xr2 & rd { rd = _cmpyr1(r1, xr2); }
i32: "DDOTP4"^uM r1,xr2,pd is $(MXU) & op6_10=0x18 & cz=1 & uM & r1 & xr2 & pd { pd = _ddotp4(r1, xr2); }
i32: "DDOTPH2"^uM p1,xr2,pd is $(MXU) & op6_10=0x17 & cz=1 & uM & p1 & xr2 & pd { pd = _ddotph2(p1, xr2); }
i32: "DDOTPH2R"^uM p1,xr2,rd is $(MXU) & op6_10=0x15 & cz=1 & uM & p1 & xr2 & rd { rd = _ddotph2r(p1, xr2); }
i32: "DDOTPL2"^uM p1,xr2,pd is $(MXU) & op6_10=0x16 & cz=1 & uM & p1 & xr2 & pd { pd = _ddotpl2(p1, xr2); }
i32: "DDOTPL2R"^uM p1,xr2,rd is $(MXU) & op6_10=0x14 & cz=1 & uM & p1 & xr2 & rd { rd = _ddotpl2r(p1, xr2); }
i32: "GMPY"^uM r1,xr2,rd is $(MXU) & op6_10=0x1f & cz=1 & uM & r1 & xr2 & rd { rd = _gmpy(r1, xr2); }
i32: "MPY2IR"^uM r1,xr2,pd is $(MXU) & op6_10=0x0f & cz=1 & uM & r1 & xr2 & pd { pd = _mpy2ir(r1, xr2); }
i32: "SMPY32"^uM r1,xr2,rd is $(MXU) & op6_10=0x19 & cz=1 & uM & r1 & xr2 & rd & ssrM { smpy32(r1, xr2, rd, ssrM); }
i32: "XORMPY"^uM r1,xr2,rd is $(MXU) & op6_10=0x1b & cz=1 & uM & r1 & xr2 & rd { rd = _xormpy(r1, xr2); }

################################################################
# .D unit, extended
################################################################

i32: ^cc^"ADD"^uD r1,xr2,rd is $(DXU) & op6_9=0xa & cc & uD & r1 & xr2 & rd { rd = r1 + xr2; }
i32: ^cc^"ADD"^uD sc5,xr2,rd is $(DXU) & op6_9=0xb & cc & uD & sc5 & xr2 & rd { rd = sc5 + xr2; }
i32: ^cc^"ADD2"^uD r1,xr2,rd is $(DXU) & op6_9=0x4 & cc & uD & r1 & xr2 & rd { rd = _add2(r1, xr2); }
i32: ^cc^"AND"^uD r1,xr2,rd is $(DXU) & op6_9=0x6 & cc & uD & r1 & xr2 & rd { rd = r1 & xr2; }
i32: ^cc^"AND"^uD sc5,xr2,rd is $(DXU) & op6_9=0x7 & cc & uD & sc5 & xr2 & rd { rd = sc5 & xr2; }
i32: ^cc^"ANDN"^uD r1,xr2,rd is $(DXU) & op6_9=0x0 & cc & uD & r1 & xr2 & rd { rd = r1 & ~xr2; }
i32: ^cc^"OR"^uD r1,xr2,rd is $(DXU) & op6_9=0x2 & cc & uD & r1 & xr2 & rd { rd = r1 | xr2; }
i32: ^cc^"OR"^uD sc5,xr2,rd is $(DXU) & op6_9=0x3 & cc & uD & sc5 & xr2 & rd { rd = sc5 | xr2; }
i32: ^cc^"SUB"^uD r1,xr2,rd is $(DXU) & op6_9=0xc & cc & uD & r1 & xr2 & rd { rd = r1 - xr2; }
i32: ^cc^"SUB2"^uD r1,xr2,rd is $(DXU) & op6_9=0x5 & cc & uD & r1 & xr2 & rd { rd = _sub2(r1, xr2); }
i32: ^cc^"XOR"^uD r1,xr2,rd is $(DXU) & op6_9=0xe & cc & uD & r1 & xr2 & rd { rd = r1 ^ xr2; }
i32: ^cc^"XOR"^uD sc5,xr2,rd is $(DXU) & op6_9=0xf & cc & uD & sc5 & xr2 & rd { rd = sc5 ^ xr2; }
i32: ^cc^"MV"^uD xr2,rd is $(DXU) & op6_9=0xb & scst5=0 & cc & uD & xr2 & rd { rd = xr2; }
i32: ^cc^"MV"^uD xr2,rd is $(DXU) & op6_9=0x3 & scst5=0 & cc & uD & xr2 & rd { rd = xr2; }
i32: ^cc^"NOT"^uD xr2,rd is $(DXU) & op6_9=0xf & ucst5=0x1f & cc & uD & xr2 & rd { rd = ~xr2; }
i32: ^cc^"SUB"^uD xr2,nk,rd is $(DXU) & op6_9=0xb & ucst5>15 & scst5 & cc & uD & xr2 & rd [ nk = -scst5; ] { rd = xr2 - nk; }
