# TMS320C6000 table-driven 32-bit instructions
#
# Generated from the opcode tables of MAME's TMS320C6x disassembler;
# operands are named as in tms320c6x.sinc.

################################################################
# .L unit
################################################################

i32: ^cc^"ADD"^uL r1,xr2,rd is $(LU) & lop=0x03 & cc & uL & r1 & xr2 & rd { rd = r1 + xr2; }
i32: ^cc^"ADD"^uL r1,xr2,pd is $(LU) & lop=0x23 & cc & uL & r1 & xr2 & pd { local t:8 = sext(r1) + sext(xr2); long40(pd, t); }
i32: ^cc^"ADD"^uL xr1,p2,pd is $(LU) & lop=0x21 & cc & uL & xr1 & p2 & pd { local t:8 = sext(xr1) + sext(p2:5); long40(pd, t); }
i32: ^cc^"ADD"^uL sc5,xr2,rd is $(LU) & lop=0x02 & cc & uL & sc5 & xr2 & rd { rd = sc5 + xr2; }
i32: ^cc^"ADD"^uL sc5,p2,pd is $(LU) & lop=0x20 & cc & uL & sc5 & p2 & pd { local t:8 = sext(sc5) + sext(p2:5); long40(pd, t); }
i32: ^cc^"ADDU"^uL r1,xr2,pd is $(LU) & lop=0x2b & cc & uL & r1 & xr2 & pd { local t:8 = zext(r1) + zext(xr2); long40(pd, t); }
i32: ^cc^"ADDU"^uL xr1,p2,pd is $(LU) & lop=0x29 & cc & uL & xr1 & p2 & pd { local t:8 = zext(xr1) + zext(p2:5); long40(pd, t); }
i32: ^cc^"ADD2"^uL r1,xr2,rd is $(LU) & lop=0x05 & cc & uL & r1 & xr2 & rd { rd = _add2(r1, xr2); }
i32: ^cc^"ADD4"^uL r1,xr2,rd is $(LU) & lop=0x65 & cc & uL & r1 & xr2 & rd { rd = _add4(r1, xr2); }
i32: ^cc^"ADDDP"^uL p1,xp2,pd is $(LU) & lop=0x18 & cc & uL & p1 & xp2 & pd { pd = p1 f+ xp2; }
i32: ^cc^"ADDSP"^uL r1,xr2,rd is $(LU) & lop=0x10 & cc & uL & r1 & xr2 & rd { rd = r1 f+ xr2; }
i32: ^cc^"AND"^uL r1,xr2,rd is $(LU) & lop=0x7b & cc & uL & r1 & xr2 & rd { rd = r1 & xr2; }
i32: ^cc^"AND"^uL sc5,xr2,rd is $(LU) & lop=0x7a & cc & uL & sc5 & xr2 & rd { rd = sc5 & xr2; }
i32: ^cc^"ANDN"^uL r1,xr2,rd is $(LU) & lop=0x7c & cc & uL & r1 & xr2 & rd { rd = r1 & ~xr2; }
i32: ^cc^"CMPEQ"^uL r1,xr2,rd is $(LU) & lop=0x53 & cc & uL & r1 & xr2 & rd { rd = zext(r1 == xr2); }
i32: ^cc^"CMPEQ"^uL sc5,xr2,rd is $(LU) & lop=0x52 & cc & uL & sc5 & xr2 & rd { rd = zext(sc5 == xr2); }
i32: ^cc^"CMPEQ"^uL xr1,p2,rd is $(LU) & lop=0x51 & cc & uL & xr1 & p2 & rd { local la:8 = sext(xr1); local lb:8 = sext(p2:5); rd = zext(la == lb); }
i32: ^cc^"CMPEQ"^uL sc5,p2,rd is $(LU) & lop=0x50 & cc & uL & sc5 & p2 & rd { local la:8 = sext(sc5); local lb:8 = sext(p2:5); rd = zext(la == lb); }
i32: ^cc^"CMPGT"^uL r1,xr2,rd is $(LU) & lop=0x47 & cc & uL & r1 & xr2 & rd { rd = zext(r1 s> xr2); }
i32: ^cc^"CMPGT"^uL sc5,xr2,rd is $(LU) & lop=0x46 & cc & uL & sc5 & xr2 & rd { rd = zext(sc5 s> xr2); }
i32: ^cc^"CMPGT"^uL xr1,p2,rd is $(LU) & lop=0x45 & cc & uL & xr1 & p2 & rd { local la:8 = sext(xr1); local lb:8 = sext(p2:5); rd = zext(la s> lb); }
i32: ^cc^"CMPGT"^uL sc5,p2,rd is $(LU) & lop=0x44 & cc & uL & sc5 & p2 & rd { local la:8 = sext(sc5); local lb:8 = sext(p2:5); rd = zext(la s> lb); }
i32: ^cc^"CMPGTU"^uL r1,xr2,rd is $(LU) & lop=0x4f & cc & uL & r1 & xr2 & rd { rd = zext(r1 > xr2); }
i32: ^cc^"CMPGTU"^uL uc5,xr2,rd is $(LU) & lop=0x4e & cc & uL & uc5 & xr2 & rd { rd = zext(uc5 > xr2); }
i32: ^cc^"CMPGTU"^uL xr1,p2,rd is $(LU) & lop=0x4d & cc & uL & xr1 & p2 & rd { local la:8 = zext(xr1); local lb:8 = zext(p2:5); rd = zext(la > lb); }
i32: ^cc^"CMPGTU"^uL uc5,p2,rd is $(LU) & lop=0x4c & cc & uL & uc5 & p2 & rd { local la:8 = zext(uc5); local lb:8 = zext(p2:5); rd = zext(la > lb); }
i32: ^cc^"CMPLT"^uL r1,xr2,rd is $(LU) & lop=0x57 & cc & uL & r1 & xr2 & rd { rd = zext(r1 s< xr2); }
i32: ^cc^"CMPLT"^uL sc5,xr2,rd is $(LU) & lop=0x56 & cc & uL & sc5 & xr2 & rd { rd = zext(sc5 s< xr2); }
i32: ^cc^"CMPLT"^uL xr1,p2,rd is $(LU) & lop=0x55 & cc & uL & xr1 & p2 & rd { local la:8 = sext(xr1); local lb:8 = sext(p2:5); rd = zext(la s< lb); }
i32: ^cc^"CMPLT"^uL sc5,p2,rd is $(LU) & lop=0x54 & cc & uL & sc5 & p2 & rd { local la:8 = sext(sc5); local lb:8 = sext(p2:5); rd = zext(la s< lb); }
i32: ^cc^"CMPLTU"^uL r1,xr2,rd is $(LU) & lop=0x5f & cc & uL & r1 & xr2 & rd { rd = zext(r1 < xr2); }
i32: ^cc^"CMPLTU"^uL uc5,xr2,rd is $(LU) & lop=0x5e & cc & uL & uc5 & xr2 & rd { rd = zext(uc5 < xr2); }
i32: ^cc^"CMPLTU"^uL xr1,p2,rd is $(LU) & lop=0x5d & cc & uL & xr1 & p2 & rd { local la:8 = zext(xr1); local lb:8 = zext(p2:5); rd = zext(la < lb); }
i32: ^cc^"CMPLTU"^uL uc5,p2,rd is $(LU) & lop=0x5c & cc & uL & uc5 & p2 & rd { local la:8 = zext(uc5); local lb:8 = zext(p2:5); rd = zext(la < lb); }
i32: ^cc^"DPINT"^uL p2,rd is $(LU) & lop=0x08 & cc & uL & p2 & rd { rd = trunc(round(p2)); }
i32: ^cc^"DPSP"^uL p2,rd is $(LU) & lop=0x09 & cc & uL & p2 & rd { rd = float2float(p2); }
i32: ^cc^"DPTRUNC"^uL p2,rd is $(LU) & lop=0x01 & cc & uL & p2 & rd { rd = trunc(p2); }
i32: ^cc^"INTDP"^uL xr2,pd is $(LU) & lop=0x39 & cc & uL & xr2 & pd { pd = int2float(xr2); }
i32: ^cc^"INTDPU"^uL xr2,pd is $(LU) & lop=0x3b & cc & uL & xr2 & pd { local v:8 = zext(xr2); pd = int2float(v); }
i32: ^cc^"INTSP"^uL xr2,rd is $(LU) & lop=0x4a & cc & uL & xr2 & rd { rd = int2float(xr2); }
i32: ^cc^"INTSPU"^uL xr2,rd is $(LU) & lop=0x49 & cc & uL & xr2 & rd { local v:8 = zext(xr2); rd = int2float(v); }
i32: ^cc^"LMBD"^uL r1,xr2,rd is $(LU) & lop=0x6b & cc & uL & r1 & xr2 & rd { local v:4 = xr2 ^ ((r1 & 1) - 1); rd = lzcount(v); }
i32: ^cc^"MAX2"^uL r1,xr2,rd is $(LU) & lop=0x42 & cc & uL & r1 & xr2 & rd { rd = _max2(r1, xr2); }
i32: ^cc^"MAXU4"^uL r1,xr2,rd is $(LU) & lop=0x43 & cc & uL & r1 & xr2 & rd { maxu4(r1, xr2, rd); }
i32: ^cc^"MIN2"^uL r1,xr2,rd is $(LU) & lop=0x41 & cc & uL & r1 & xr2 & rd { rd = _min2(r1, xr2); }
i32: ^cc^"MINU4"^uL r1,xr2,rd is $(LU) & lop=0x48 & cc & uL & r1 & xr2 & rd { minu4(r1, xr2, rd); }
i32: ^cc^"NORM"^uL xr2,rd is $(LU) & lop=0x63 & cc & uL & xr2 & rd { local v:4 = xr2 ^ (xr2 s>> 31); rd = lzcount(v) - 1; }
i32: ^cc^"NORM"^uL p2,rd is $(LU) & lop=0x60 & cc & uL & p2 & rd { local v:8 = sext(p2:5); local w:8 = v ^ (v s>> 63); rd = lzcount(w) - 25; }
i32: ^cc^"OR"^uL r1,xr2,rd is $(LU) & lop=0x7f & cc & uL & r1 & xr2 & rd { rd = r1 | xr2; }
i32: ^cc^"OR"^uL sc5,xr2,rd is $(LU) & lop=0x7e & cc & uL & sc5 & xr2 & rd { rd = sc5 | xr2; }
i32: ^cc^"PACK2"^uL r1,xr2,rd is $(LU) & lop=0x00 & cc & uL & r1 & xr2 & rd { rd = (r1 << 16) | (xr2 & 0xffff); }
i32: ^cc^"PACKH2"^uL r1,xr2,rd is $(LU) & lop=0x1e & cc & uL & r1 & xr2 & rd { rd = (r1 & 0xffff0000) | (xr2 >> 16); }
i32: ^cc^"PACKH4"^uL r1,xr2,rd is $(LU) & lop=0x69 & cc & uL & r1 & xr2 & rd { rd = _packh4(r1, xr2); }
i32: ^cc^"PACKHL2"^uL r1,xr2,rd is $(LU) & lop=0x1c & cc & uL & r1 & xr2 & rd { rd = (r1 & 0xffff0000) | (xr2 & 0xffff); }
i32: ^cc^"PACKLH2"^uL r1,xr2,rd is $(LU) & lop=0x1b & cc & uL & r1 & xr2 & rd { rd = (r1 << 16) | (xr2 >> 16); }
i32: ^cc^"PACKL4"^uL r1,xr2,rd is $(LU) & lop=0x68 & cc & uL & r1 & xr2 & rd { packl4(r1, xr2, rd); }
i32: ^cc^"SADD"^uL r1,xr2,rd is $(LU) & lop=0x13 & cc & uL & r1 & xr2 & rd & ssrL { sadd32(r1, xr2, rd, ssrL); }
i32: ^cc^"SADD"^uL xr1,p2,pd is $(LU) & lop=0x31 & cc & uL & xr1 & p2 & pd & ssrL { local r:8 = sext(xr1) + sext(p2:5); sat40(r, pd, ssrL); }
i32: ^cc^"SADD"^uL sc5,xr2,rd is $(LU) & lop=0x12 & cc & uL & sc5 & xr2 & rd & ssrL { sadd32(sc5, xr2, rd, ssrL); }
i32: ^cc^"SADD"^uL sc5,p2,pd is $(LU) & lop=0x30 & cc & uL & sc5 & p2 & pd & ssrL { local r:8 = sext(sc5) + sext(p2:5); sat40(r, pd, ssrL); }
i32: ^cc^"SAT"^uL p2,rd is $(LU) & lop=0x40 & cc & uL & p2 & rd & ssrL { local v:8 = sext(p2:5); sat32(v, rd, ssrL); }
i32: ^cc^"SHLMB"^uL r1,xr2,rd is $(LU) & lop=0x61 & cc & uL & r1 & xr2 & rd { rd = (xr2 << 8) | (r1 >> 24); }
i32: ^cc^"SHRMB"^uL r1,xr2,rd is $(LU) & lop=0x62 & cc & uL & r1 & xr2 & rd { rd = (xr2 >> 8) | (r1 << 24); }
i32: ^cc^"SPINT"^uL xr2,rd is $(LU) & lop=0x0a & cc & uL & xr2 & rd { rd = trunc(round(xr2)); }
i32: ^cc^"SPTRUNC"^uL xr2,rd is $(LU) & lop=0x0b & cc & uL & xr2 & rd { rd = trunc(xr2); }
i32: ^cc^"SSUB"^uL r1,xr2,rd is $(LU) & lop=0x0f & cc & uL & r1 & xr2 & rd & ssrL { ssub32(r1, xr2, rd, ssrL); }
i32: ^cc^"SSUB"^uL xr1,r2,rd is $(LU) & lop=0x1f & cc & uL & xr1 & r2 & rd & ssrL { ssub32(xr1, r2, rd, ssrL); }
i32: ^cc^"SSUB"^uL sc5,xr2,rd is $(LU) & lop=0x0e & cc & uL & sc5 & xr2 & rd & ssrL { ssub32(sc5, xr2, rd, ssrL); }
i32: ^cc^"SSUB"^uL sc5,p2,pd is $(LU) & lop=0x2c & cc & uL & sc5 & p2 & pd & ssrL { local r:8 = sext(sc5) - sext(p2:5); sat40(r, pd, ssrL); }
i32: ^cc^"SSUB2"^uL r1,xr2,rd is $(LU) & lop=0x64 & cc & uL & r1 & xr2 & rd { rd = _ssub2(r1, xr2); }
i32: ^cc^"SUB"^uL r1,xr2,rd is $(LU) & lop=0x07 & cc & uL & r1 & xr2 & rd { rd = r1 - xr2; }
i32: ^cc^"SUB"^uL xr1,r2,rd is $(LU) & lop=0x17 & cc & uL & xr1 & r2 & rd { rd = xr1 - r2; }
i32: ^cc^"SUB"^uL r1,xr2,pd is $(LU) & lop=0x27 & cc & uL & r1 & xr2 & pd { local t:8 = sext(r1) - sext(xr2); long40(pd, t); }
i32: ^cc^"SUB"^uL xr1,r2,pd is $(LU) & lop=0x37 & cc & uL & xr1 & r2 & pd { local t:8 = sext(xr1) - sext(r2); long40(pd, t); }
i32: ^cc^"SUB"^uL sc5,xr2,rd is $(LU) & lop=0x06 & cc & uL & sc5 & xr2 & rd { rd = sc5 - xr2; }
i32: ^cc^"SUB"^uL sc5,p2,pd is $(LU) & lop=0x24 & cc & uL & sc5 & p2 & pd { local t:8 = sext(sc5) - sext(p2:5); long40(pd, t); }
i32: ^cc^"SUBABS4"^uL r1,xr2,rd is $(LU) & lop=0x5a & cc & uL & r1 & xr2 & rd { rd = _subabs4(r1, xr2); }
i32: ^cc^"SUBC"^uL r1,xr2,rd is $(LU) & lop=0x4b & cc & uL & r1 & xr2 & rd { local ge:4 = zext(r1 >= xr2); rd = ((r1 - (xr2 * ge)) << 1) + ge; }
i32: ^cc^"SUBDP"^uL p1,xp2,pd is $(LU) & lop=0x19 & cc & uL & p1 & xp2 & pd { pd = p1 f- xp2; }
i32: ^cc^"SUBDP"^uL xp1,p2,pd is $(LU) & lop=0x1d & cc & uL & xp1 & p2 & pd { pd = xp1 f- p2; }
i32: ^cc^"SUBSP"^uL r1,xr2,rd is $(LU) & lop=0x11 & cc & uL & r1 & xr2 & rd { rd = r1 f- xr2; }
i32: ^cc^"SUBSP"^uL xr1,r2,rd is $(LU) & lop=0x15 & cc & uL & xr1 & r2 & rd { rd = xr1 f- r2; }
i32: ^cc^"SUBU"^uL r1,xr2,pd is $(LU) & lop=0x2f & cc & uL & r1 & xr2 & pd { local t:8 = zext(r1) - zext(xr2); long40(pd, t); }
i32: ^cc^"SUBU"^uL xr1,r2,pd is $(LU) & lop=0x3f & cc & uL & xr1 & r2 & pd { local t:8 = zext(xr1) - zext(r2); long40(pd, t); }
i32: ^cc^"SUB2"^uL r1,xr2,rd is $(LU) & lop=0x04 & cc & uL & r1 & xr2 & rd { rd = _sub2(r1, xr2); }
i32: ^cc^"SUB4"^uL r1,xr2,rd is $(LU) & lop=0x66 & cc & uL & r1 & xr2 & rd { rd = _sub4(r1, xr2); }
i32: ^cc^"XOR"^uL r1,xr2,rd is $(LU) & lop=0x6f & cc & uL & r1 & xr2 & rd { rd = r1 ^ xr2; }
i32: ^cc^"XOR"^uL sc5,xr2,rd is $(LU) & lop=0x6e & cc & uL & sc5 & xr2 & rd { rd = sc5 ^ xr2; }
i32: ^cc^"ABS"^uL p2,pd is $(LU) & lop=0x38 & cc & uL & p2 & pd & ssrL { abs40(p2, pd, ssrL); }
i32: ^cc^"LMBD"^uL lb,xr2,rd is $(LU) & lop=0x6a & cc & uL & ucst5 & xr2 & rd [ lb = ucst5 & 1; ] { local v:4 = xr2 ^ (lb - 1); rd = lzcount(v); }
i32: ^cc^"MV"^uL xr2,rd is $(LU) & lop=0x02 & scst5=0 & cc & uL & xr2 & rd { rd = xr2; }
i32: ^cc^"MV"^uL xr2,rd is $(LU) & lop=0x7e & scst5=0 & cc & uL & xr2 & rd { rd = xr2; }
i32: ^cc^"MV"^uL p2,pd is $(LU) & lop=0x20 & scst5=0 & cc & uL & p2 & pd { local t:8 = sext(p2:5); long40(pd, t); }
i32: ^cc^"NEG"^uL xr2,rd is $(LU) & lop=0x06 & scst5=0 & cc & uL & xr2 & rd { rd = -xr2; }
i32: ^cc^"NEG"^uL p2,pd is $(LU) & lop=0x24 & scst5=0 & cc & uL & p2 & pd { local t:8 = -sext(p2:5); long40(pd, t); }
i32: ^cc^"NOT"^uL xr2,rd is $(LU) & lop=0x6e & ucst5=0x1f & cc & uL & xr2 & rd { rd = ~xr2; }
i32: ^cc^"SUB"^uL xr2,nk,rd is $(LU) & lop=0x02 & ucst5>15 & scst5 & cc & uL & xr2 & rd [ nk = -scst5; ] { rd = xr2 - nk; }
i32: ^cc^"SUB"^uL p2,nk,pd is $(LU) & lop=0x20 & ucst5>15 & scst5 & cc & uL & p2 & pd [ nk = -scst5; ] { local t:8 = sext(p2:5) - nk; long40(pd, t); }

################################################################
# .L unit, nonconditional
################################################################

i32: "ADDSUB"^uL r1,xr2,pd is $(LU) & lop=0x0c & cz=1 & uL & r1 & xr2 & pd { local hi:4 = r1 + xr2; local lo:4 = r1 - xr2; pd = (zext(hi) << 32) | zext(lo); }
i32: "ADDSUB2"^uL r1,xr2,pd is $(LU) & lop=0x0d & cz=1 & uL & r1 & xr2 & pd { pd = _addsub2(r1, xr2); }
i32: "DPACK2"^uL r1,xr2,pd is $(LU) & lop=0x34 & cz=1 & uL & r1 & xr2 & pd { pd = _dpack2(r1, xr2); }
i32: "DPACKX2"^uL r1,xr2,pd is $(LU) & lop=0x33 & cz=1 & uL & r1 & xr2 & pd { pd = _dpackx2(r1, xr2); }
i32: "SADDSUB"^uL r1,xr2,pd is $(LU) & lop=0x0e & cz=1 & uL & r1 & xr2 & pd { pd = _saddsub(r1, xr2); }
i32: "SADDSUB2"^uL r1,xr2,pd is $(LU) & lop=0x0f & cz=1 & uL & r1 & xr2 & pd { pd = _saddsub2(r1, xr2); }
i32: "SHFL3"^uL r1,xr2,pd is $(LU) & lop=0x36 & cz=1 & uL & r1 & xr2 & pd { pd = _shfl3(r1, xr2); }

################################################################
# .S unit floating-point add and subtract, in the .L opcode space
################################################################

i32: ^cc^"ADDSP"^uS r1,xr2,rd is $(LU) & lop=0x70 & cc & uS & r1 & xr2 & rd { rd = r1 f+ xr2; }
i32: ^cc^"ADDDP"^uS p1,xp2,pd is $(LU) & lop=0x72 & cc & uS & p1 & xp2 & pd { pd = p1 f+ xp2; }
i32: ^cc^"SUBSP"^uS r1,xr2,rd is $(LU) & lop=0x71 & cc & uS & r1 & xr2 & rd { rd = r1 f- xr2; }
i32: ^cc^"SUBSP"^uS xr2,r1,rd is $(LU) & lop=0x75 & cc & uS & xr2 & r1 & rd { rd = xr2 f- r1; }
i32: ^cc^"SUBDP"^uS p1,xp2,pd is $(LU) & lop=0x73 & cc & uS & p1 & xp2 & pd { pd = p1 f- xp2; }
i32: ^cc^"SUBDP"^uS xp2,p1,pd is $(LU) & lop=0x77 & cc & uS & xp2 & p1 & pd { pd = xp2 f- p1; }

################################################################
# .S unit
################################################################

i32: ^cc^"ADD"^uS r1,xr2,rd is $(SU) & sop=0x07 & cc & uS & r1 & xr2 & rd { rd = r1 + xr2; }
i32: ^cc^"ADD"^uS sc5,xr2,rd is $(SU) & sop=0x06 & cc & uS & sc5 & xr2 & rd { rd = sc5 + xr2; }
i32: ^cc^"ADD2"^uS r1,xr2,rd is $(SU) & sop=0x01 & cc & uS & r1 & xr2 & rd { rd = _add2(r1, xr2); }
i32: ^cc^"AND"^uS r1,xr2,rd is $(SU) & sop=0x1f & cc & uS & r1 & xr2 & rd { rd = r1 & xr2; }
i32: ^cc^"AND"^uS sc5,xr2,rd is $(SU) & sop=0x1e & cc & uS & sc5 & xr2 & rd { rd = sc5 & xr2; }
i32: ^cc^"CLR"^uS xr2,r1,rd is $(SU) & sop=0x3f & cc & uS & xr2 & r1 & rd { local fa:4 = (r1 >> 5) & 0x1f; local fb:4 = r1 & 0x1f; local m:4 = (0xffffffff << fa) & (0xffffffff >> (31 - fb)); rd = xr2 & ~m; }
i32: ^cc^"EXT"^uS xr2,r1,rd is $(SU) & sop=0x2f & cc & uS & xr2 & r1 & rd { local fa:4 = (r1 >> 5) & 0x1f; local fb:4 = r1 & 0x1f; rd = (xr2 << fa) s>> fb; }
