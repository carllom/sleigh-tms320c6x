	"D2,M2" "L1,D2,M2" "L2,D2,M2" "L1,L2,D2,M2" "S1,D2,M2" "L1,S1,D2,M2" "L2,S1,D2,M2" "L1,L2,S1,D2,M2"
	"S2,D2,M2" "L1,S2,D2,M2" "L2,S2,D2,M2" "L1,L2,S2,D2,M2" "S1,S2,D2,M2" "L1,S1,S2,D2,M2" "L2,S1,S2,D2,M2" "L1,L2,S1,S2,D2,M2"
	"D1,D2,M2" "L1,D1,D2,M2" "L2,D1,D2,M2" "L1,L2,D1,D2,M2" "S1,D1,D2,M2" "L1,S1,D1,D2,M2" "L2,S1,D1,D2,M2" "L1,L2,S1,D1,D2,M2"
	"S2,D1,D2,M2" "L1,S2,D1,D2,M2" "L2,S2,D1,D2,M2" "L1,L2,S2,D1,D2,M2" "S1,S2,D1,D2,M2" "L1,S1,S2,D1,D2,M2" "L2,S1,S2,D1,D2,M2" "L1,L2,S1,S2,D1,D2,M2"
	"M1,M2" "L1,M1,M2" "L2,M1,M2" "L1,L2,M1,M2" "S1,M1,M2" "L1,S1,M1,M2" "L2,S1,M1,M2" "L1,L2,S1,M1,M2"
	"S2,M1,M2" "L1,S2,M1,M2" "L2,S2,M1,M2" "L1,L2,S2,M1,M2" "S1,S2,M1,M2" "L1,S1,S2,M1,M2" "L2,S1,S2,M1,M2" "L1,L2,S1,S2,M1,M2"
