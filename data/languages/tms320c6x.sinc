# Texas Instruments TMS320C6000 (C64x+ / C674x) common definitions
#
# Reference: SPRUFE8B, TMS320C674x DSP CPU and Instruction Set Reference Guide
#
# Fetch packets
#   Code is fetched in 32-byte aligned fetch packets. A packet whose last word
#   has 0xE in bits 31-28 is a header-based packet: the header says which of
#   the other seven words hold two 16-bit compact instructions, and carries the
#   p-bits of the compact instructions and some decode options for them.
#   Sleigh cannot look ahead to the header, so the header fields are kept in
#   context registers (fph, layout, hpbits, prot, rs, dsz, br, sat) that the
#   "TMS320C6x Fetch Packet Headers" analyzer (or the C6xFetchPacketHeaders
#   script) sets over each header-based packet before disassembly. Without
#   that context every word decodes as a 32-bit instruction.
#
# Delay slots
#   Branches take effect after five delay slots, counted in CPU cycles, and
#   multi-cycle NOPs (and the NOP fields of BNOP/ADDKPC, CALLP's implied NOPs,
#   and loads in protected packets) count as several. The branch instruction
#   only records the target (context dtgt for constants, register BRT for
#   register targets, BRC for the condition); the last instruction of the
#   execute packet that completes the fifth delay slot carries the p-code
#   goto/call/return. Writing B3 with MVK/MVKH/ADDKPC during the delay slots
#   turns the jump into a call. This is followed in disassembly order, so a
#   branch target inside pending delay slots sees no pending branch.
#
# Not modelled
#   Parallel execution: instructions in an execute packet run in order, so a
#   packet that reads a register another instruction of the same packet writes
#   sees the new value. Delayed results of loads, multiplies and floating-point
#   instructions are written immediately. Circular addressing (AMR) is ignored.
#   SPLOOP buffers are shown as markers; the loop body is not repeated.

define endian=little;
define alignment=2;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

define register offset=0x000 size=4 [
	A0  A1  A2  A3  A4  A5  A6  A7  A8  A9  A10 A11 A12 A13 A14 A15
	A16 A17 A18 A19 A20 A21 A22 A23 A24 A25 A26 A27 A28 A29 A30 A31 ];
define register offset=0x080 size=4 [
	B0  B1  B2  B3  B4  B5  B6  B7  B8  B9  B10 B11 B12 B13 B14 B15
	B16 B17 B18 B19 B20 B21 B22 B23 B24 B25 B26 B27 B28 B29 B30 B31 ];

# register pairs (also the 40-bit long registers), odd:even
define register offset=0x000 size=8 [
	A1_A0   A3_A2   A5_A4   A7_A6   A9_A8   A11_A10 A13_A12 A15_A14
	A17_A16 A19_A18 A21_A20 A23_A22 A25_A24 A27_A26 A29_A28 A31_A30 ];
define register offset=0x080 size=8 [
	B1_B0   B3_B2   B5_B4   B7_B6   B9_B8   B11_B10 B13_B12 B15_B14
	B17_B16 B19_B18 B21_B20 B23_B22 B25_B24 B27_B26 B29_B28 B31_B30 ];

define register offset=0x100 size=4 [ PC ];

# control register file
define register offset=0x140 size=4 [
	AMR    CSR    IFR    ISR    ICR    IER    ISTP   IRP
	NRP    TSCL   TSCH   ILC    RILC   REP    DNUM   FADCR
	FAUCR  FMCR   SSR    GPLYA  GPLYB  GFPGFR DIER   TSR
	ITSR   NTSR   EFR    ECR    IERR ];

# pending branch target and condition, see "Delay slots" above
define register offset=0x200 size=4 [ BRT ];
define register offset=0x204 size=1 [ BRC ];

define register offset=0x300 size=16 [ contextreg ];
define context contextreg
	# pending branch target address
	dtgt   = (0,31) noflow

	# fetch packet header, set over the whole packet by the analyzer
	fph    = (32,32) noflow     # the packet has a header
	layout = (33,39) noflow     # word n holds two compact instructions
	hpbits = (40,53) noflow     # p-bits of the compact instructions
	prot   = (54,54) noflow     # loads are protected (implied NOP 4)
	rs     = (55,55) noflow     # compact registers are A16-A23/B16-B23
	dsz    = (56,58) noflow     # compact load/store data size
	br     = (59,59) noflow     # compact .S space holds branches
	sat    = (60,60) noflow     # compact arithmetic saturates

	# delay slot tracking, carried with globalset to the next instruction
	dcnt   = (64,66) noflow     # cycles until a pending branch, or 0
	dkind  = (67,69) noflow     # kind of pending branch
	dcall  = (70,70) noflow     # B3 written during the delay slots
	epx    = (71,74) noflow     # extra NOP cycles of this execute packet

	# per-instruction decode state
	rem    = (75,79) noflow     # dcnt minus the cycles of this packet
	wcomp  = (80,80) noflow     # this word holds compact instructions
	ishdr  = (81,81) noflow     # this word is the header
	hpos   = (82,85) noflow     # halfword within the fetch packet
	pb     = (86,86) noflow     # p-bit of this instruction
	isbr   = (87,87) noflow     # this instruction is a branch
	asz    = (88,89) noflow     # load/store size shift
	paren  = (90,90) noflow     # unscaled load/store offset
	spmv   = (96,103) noflow    # SPMASK unit list
	spmvn  = (96,103) noflow
	spkv   = (104,109) noflow   # SPKERNEL fstg/fcyc field

	# ii - 1 of the last SPLOOP, which SPKERNEL needs to split fstg/fcyc
	spii   = (112,115)
;

# dkind values
@define DK_JUMP      "0"   # constant target
@define DK_JUMP_C    "1"   # constant target, conditional
@define DK_JUMPR     "2"   # register target
@define DK_JUMPR_C   "3"   # register target, conditional
@define DK_RET       "4"   # B3 or IRP/NRP
@define DK_RET_C     "5"   # B3, conditional
@define DK_CALLP_A3  "6"
@define DK_CALLP_B3  "7"

# packed-data and saturating operations, named after TI's C intrinsics
define pcodeop _abs; define pcodeop _abs2; define pcodeop _add2; define pcodeop _add4; define pcodeop _addsub2; define pcodeop _avg2;
define pcodeop _avgu4; define pcodeop _bitc4; define pcodeop _bitr; define pcodeop _cmpeq2; define pcodeop _cmpeq4; define pcodeop _cmpgt2;
define pcodeop _cmpgtu4; define pcodeop _cmpy; define pcodeop _cmpyr; define pcodeop _cmpyr1; define pcodeop _ddotp4; define pcodeop _ddotph2;
define pcodeop _ddotph2r; define pcodeop _ddotpl2; define pcodeop _ddotpl2r; define pcodeop _deal; define pcodeop _dotp2; define pcodeop _dotpn2;
define pcodeop _dotpnrsu2; define pcodeop _dotprsu2; define pcodeop _dotpsu4; define pcodeop _dotpu4; define pcodeop _dpack2; define pcodeop _dpackx2;
define pcodeop _gmpy; define pcodeop _gmpy4; define pcodeop _labs; define pcodeop _ldotp2; define pcodeop _lsadd; define pcodeop _lssub;
define pcodeop _max2; define pcodeop _maxu4; define pcodeop _min2; define pcodeop _minu4; define pcodeop _mpy2; define pcodeop _mpy2ir;
define pcodeop _mpyhir; define pcodeop _mpylir; define pcodeop _mpysu4; define pcodeop _mpyu4; define pcodeop _packh4; define pcodeop _packl4;
define pcodeop _rpack2; define pcodeop _sadd; define pcodeop _sadd2; define pcodeop _saddsub; define pcodeop _saddsub2; define pcodeop _saddu4;
define pcodeop _saddus2; define pcodeop _sat; define pcodeop _shfl; define pcodeop _shfl3; define pcodeop _shr2; define pcodeop _shru2;
define pcodeop _smpy; define pcodeop _smpy2; define pcodeop _smpy32; define pcodeop _smpyh; define pcodeop _smpyhl; define pcodeop _smpylh;
define pcodeop _spack2; define pcodeop _spacku4; define pcodeop _sshl; define pcodeop _sshvl; define pcodeop _sshvr; define pcodeop _ssub;
define pcodeop _ssub2; define pcodeop _sub2; define pcodeop _sub4; define pcodeop _subabs4; define pcodeop _swap4; define pcodeop _unpkhu4;
define pcodeop _unpklu4; define pcodeop _xormpy; define pcodeop _xpnd2; define pcodeop _xpnd4;

define pcodeop idle;
define pcodeop swi;             # SWE/SWENR software exception
define pcodeop disableInterrupts;
define pcodeop restoreInterrupts;
define pcodeop sploop;
define pcodeop sploopd;
define pcodeop sploopw;
define pcodeop spkernel;
define pcodeop spkernelr;
define pcodeop spmask;
define pcodeop spmaskr;


################################################################
# Tokens
################################################################

define token insn32(32)
	p32    = (0,0)
	s      = (1,1)
	b2     = (2,2)
	b2_3   = (2,3)
	b2_4   = (2,4)
	b2_5   = (2,5)
	b2_6   = (2,6)
	b2_11  = (2,11)
	ldop   = (4,6)
	lop    = (5,11)
	b6     = (6,6)
	fop    = (6,7)
	op6_9  = (6,9)
	op6_10 = (6,10)
	sop    = (6,11)
	y      = (7,7)
	mop    = (7,11)
	dop    = (7,12)
	ldr    = (8,8)
	cstb   = (8,12) dec
	b9_10  = (9,10)
	b10    = (10,10)
	b11    = (11,11)
	b12    = (12,12)
	x      = (12,12)
	src1   = (13,17)
	s1A    = (13,17)
	s1B    = (13,17)
	s1pA   = (14,17)
	s1pB   = (14,17)
	s1pAn  = (14,17)
	s1pBn  = (14,17)
	scst5  = (13,17) signed
	ucst5  = (13,17) dec
	csta   = (13,17) dec
	nop3   = (13,15) dec
	nopc   = (13,16)
	nopk   = (13,16)
	lbop   = (13,16)
	b17    = (17,17)
	src2   = (18,22)
	s2A    = (18,22)
	s2B    = (18,22)
	s2pA   = (19,22)
	s2pB   = (19,22)
	s2pAn  = (19,22)
	s2pBn  = (19,22)
	scst5b = (18,22) signed
	crlo2  = (18,22)
	crw2   = (18,22)
	mask8  = (18,25)
	dst    = (23,27)
	dA     = (23,27)
	dB     = (23,27)
	dpA    = (24,27)
	dpB    = (24,27)
	dpAn   = (24,27)
	dpBn   = (24,27)
	sc     = (23,23)
	crlo   = (23,27)
	crw    = (23,27)
	stgcyc = (22,27) dec
	ii5    = (23,27)
	cst7   = (16,22) signed
	cst10  = (13,22) signed
	cst12  = (16,27) signed
	ucst15 = (8,22) dec
	scst16 = (7,22) signed
	ucst16 = (7,22)
	scst21 = (7,27) signed
	z      = (28,28)
	creg   = (29,31)
	cz     = (28,31)

	# fetch packet header
	hpall  = (0,13)
	hsat   = (14,14)
	hbr    = (15,15)
	hdsz   = (16,18)
	hdw    = (18,18)
	hrs    = (19,19)
	hprot  = (20,20)
	hl0    = (21,21)
	hl1    = (22,22)
	hl2    = (23,23)
	hl3    = (24,24)
	hl4    = (25,25)
	hl5    = (26,26)
	hl6    = (27,27)
	hmagic = (28,31)
;

attach variables [ s1A s2A dA ] [
	A0  A1  A2  A3  A4  A5  A6  A7  A8  A9  A10 A11 A12 A13 A14 A15
	A16 A17 A18 A19 A20 A21 A22 A23 A24 A25 A26 A27 A28 A29 A30 A31 ];
attach variables [ s1B s2B dB ] [
	B0  B1  B2  B3  B4  B5  B6  B7  B8  B9  B10 B11 B12 B13 B14 B15
	B16 B17 B18 B19 B20 B21 B22 B23 B24 B25 B26 B27 B28 B29 B30 B31 ];
attach variables [ s1pA s2pA dpA ] [
	A1_A0   A3_A2   A5_A4   A7_A6   A9_A8   A11_A10 A13_A12 A15_A14
	A17_A16 A19_A18 A21_A20 A23_A22 A25_A24 A27_A26 A29_A28 A31_A30 ];
attach variables [ s1pB s2pB dpB ] [
	B1_B0   B3_B2   B5_B4   B7_B6   B9_B8   B11_B10 B13_B12 B15_B14
	B17_B16 B19_B18 B21_B20 B23_B22 B25_B24 B27_B26 B29_B28 B31_B30 ];
attach names [ s1pAn s2pAn dpAn ] [
	"A1:A0"   "A3:A2"   "A5:A4"   "A7:A6"   "A9:A8"   "A11:A10" "A13:A12" "A15:A14"
	"A17:A16" "A19:A18" "A21:A20" "A23:A22" "A25:A24" "A27:A26" "A29:A28" "A31:A30" ];
attach names [ s1pBn s2pBn dpBn ] [
	"B1:B0"   "B3:B2"   "B5:B4"   "B7:B6"   "B9:B8"   "B11:B10" "B13:B12" "B15:B14"
	"B17:B16" "B19:B18" "B21:B20" "B23:B22" "B25:B24" "B27:B26" "B29:B28" "B31:B30" ];

# control registers, read (MVC from) and write (MVC to)
attach variables [ crlo2 ] [
	AMR  CSR  IFR  ICR  IER  ISTP IRP  NRP  _    _    TSCL TSCH _    ILC  RILC REP
	_    DNUM FADCR FAUCR FMCR SSR GPLYA GPLYB GFPGFR DIER TSR ITSR NTSR EFR _    IERR ];
attach variables [ crw ] [
	AMR  CSR  ISR  ICR  IER  ISTP IRP  NRP  _    _    TSCL TSCH _    ILC  RILC REP
	_    DNUM FADCR FAUCR FMCR SSR GPLYA GPLYB GFPGFR DIER TSR ITSR NTSR ECR  _    IERR ];

# SPMASK units, bit 0 = L1 ... bit 7 = M2
attach names [ spmvn ] [
	"" "L1" "L2" "L1,L2" "S1" "L1,S1" "L2,S1" "L1,L2,S1"
	"S2" "L1,S2" "L2,S2" "L1,L2,S2" "S1,S2" "L1,S1,S2" "L2,S1,S2" "L1,L2,S1,S2"
	"D1" "L1,D1" "L2,D1" "L1,L2,D1" "S1,D1" "L1,S1,D1" "L2,S1,D1" "L1,L2,S1,D1"
	"S2,D1" "L1,S2,D1" "L2,S2,D1" "L1,L2,S2,D1" "S1,S2,D1" "L1,S1,S2,D1" "L2,S1,S2,D1" "L1,L2,S1,S2,D1"
	"D2" "L1,D2" "L2,D2" "L1,L2,D2" "S1,D2" "L1,S1,D2" "L2,S1,D2" "L1,L2,S1,D2"
	"S2,D2" "L1,S2,D2" "L2,S2,D2" "L1,L2,S2,D2" "S1,S2,D2" "L1,S1,S2,D2" "L2,S1,S2,D2" "L1,L2,S1,S2,D2"
	"D1,D2" "L1,D1,D2" "L2,D1,D2" "L1,L2,D1,D2" "S1,D1,D2" "L1,S1,D1,D2" "L2,S1,D1,D2" "L1,L2,S1,D1,D2"
	"S2,D1,D2" "L1,S2,D1,D2" "L2,S2,D1,D2" "L1,L2,S2,D1,D2" "S1,S2,D1,D2" "L1,S1,S2,D1,D2" "L2,S1,S2,D1,D2" "L1,L2,S1,S2,D1,D2"
	"M1" "L1,M1" "L2,M1" "L1,L2,M1" "S1,M1" "L1,S1,M1" "L2,S1,M1" "L1,L2,S1,M1"
	"S2,M1" "L1,S2,M1" "L2,S2,M1" "L1,L2,S2,M1" "S1,S2,M1" "L1,S1,S2,M1" "L2,S1,S2,M1" "L1,L2,S1,S2,M1"
	"D1,M1" "L1,D1,M1" "L2,D1,M1" "L1,L2,D1,M1" "S1,D1,M1" "L1,S1,D1,M1" "L2,S1,D1,M1" "L1,L2,S1,D1,M1"
	"S2,D1,M1" "L1,S2,D1,M1" "L2,S2,D1,M1" "L1,L2,S2,D1,M1" "S1,S2,D1,M1" "L1,S1,S2,D1,M1" "L2,S1,S2,D1,M1" "L1,L2,S1,S2,D1,M1"
	"D2,M1" "L1,D2,M1" "L2,D2,M1" "L1,L2,D2,M1" "S1,D2,M1" "L1,S1,D2,M1" "L2,S1,D2,M1" "L1,L2,S1,D2,M1"
	"S2,D2,M1" "L1,S2,D2,M1" "L2,S2,D2,M1" "L1,L2,S2,D2,M1" "S1,S2,D2,M1" "L1,S1,S2,D2,M1" "L2,S1,S2,D2,M1" "L1,L2,S1,S2,D2,M1"
	"D1,D2,M1" "L1,D1,D2,M1" "L2,D1,D2,M1" "L1,L2,D1,D2,M1" "S1,D1,D2,M1" "L1,S1,D1,D2,M1" "L2,S1,D1,D2,M1" "L1,L2,S1,D1,D2,M1"
