	"S2,D1,M1,M2" "L1,S2,D1,M1,M2" "L2,S2,D1,M1,M2" "L1,L2,S2,D1,M1,M2" "S1,S2,D1,M1,M2" "L1,S1,S2,D1,M1,M2" "L2,S1,S2,D1,M1,M2" "L1,L2,S1,S2,D1,M1,M2"
	"D2,M1,M2" "L1,D2,M1,M2" "L2,D2,M1,M2" "L1,L2,D2,M1,M2" "S1,D2,M1,M2" "L1,S1,D2,M1,M2" "L2,S1,D2,M1,M2" "L1,L2,S1,D2,M1,M2"
	"S2,D2,M1,M2" "L1,S2,D2,M1,M2" "L2,S2,D2,M1,M2" "L1,L2,S2,D2,M1,M2" "S1,S2,D2,M1,M2" "L1,S1,S2,D2,M1,M2" "L2,S1,S2,D2,M1,M2" "L1,L2,S1,S2,D2,M1,M2"
	"D1,D2,M1,M2" "L1,D1,D2,M1,M2" "L2,D1,D2,M1,M2" "L1,L2,D1,D2,M1,M2" "S1,D1,D2,M1,M2" "L1,S1,D1,D2,M1,M2" "L2,S1,D1,D2,M1,M2" "L1,L2,S1,D1,D2,M1,M2"
	"S2,D1,D2,M1,M2" "L1,S2,D1,D2,M1,M2" "L2,S2,D1,D2,M1,M2" "L1,L2,S2,D1,D2,M1,M2" "S1,S2,D1,D2,M1,M2" "L1,S1,S2,D1,D2,M1,M2" "L2,S1,S2,D1,D2,M1,M2" "L1,L2,S1,S2,D1,D2,M1,M2" ];

attach names [ hprot ] [ "n" "p" ];
attach names [ hrs ] [ "l" "h" ];
attach names [ hdw ] [ "W" "DW/NDW" ];
attach names [ hdsz ] [ "BU" "B" "HU" "H" "W" "B" "NW" "H" ];
attach names [ hbr ] [ "nobr" "br" ];
attach names [ hsat ] [ "nosat" "sat" ];
attach names [ hl0 hl1 hl2 hl3 hl4 hl5 hl6 ] [ "0" "1" ];


################################################################
# 32-bit operands
################################################################

# condition, displayed before the mnemonic; there is none for creg/z = 0001,
# which selects the nonconditional instructions
cc: "" is creg=0 & z=0 { export 1:1; }
cc: "[B0] " is creg=1 & z=0 { local c:1 = B0 != 0; export c; }
cc: "[!B0] " is creg=1 & z=1 { local c:1 = B0 == 0; export c; }
cc: "[B1] " is creg=2 & z=0 { local c:1 = B1 != 0; export c; }
cc: "[!B1] " is creg=2 & z=1 { local c:1 = B1 == 0; export c; }
cc: "[B2] " is creg=3 & z=0 { local c:1 = B2 != 0; export c; }
cc: "[!B2] " is creg=3 & z=1 { local c:1 = B2 == 0; export c; }
cc: "[A1] " is creg=4 & z=0 { local c:1 = A1 != 0; export c; }
cc: "[!A1] " is creg=4 & z=1 { local c:1 = A1 == 0; export c; }
cc: "[A2] " is creg=5 & z=0 { local c:1 = A2 != 0; export c; }
cc: "[!A2] " is creg=5 & z=1 { local c:1 = A2 == 0; export c; }
cc: "[A0] " is creg=6 & z=0 { local c:1 = A0 != 0; export c; }
cc: "[!A0] " is creg=6 & z=1 { local c:1 = A0 == 0; export c; }

# functional units; the X suffix marks a cross path source
uL: ".L1" is s=0 & x=0 { }
uL: ".L2" is s=1 & x=0 { }
uL: ".L1X" is s=0 & x=1 { }
uL: ".L2X" is s=1 & x=1 { }
uS: ".S1" is s=0 & x=0 { }
uS: ".S2" is s=1 & x=0 { }
uS: ".S1X" is s=0 & x=1 { }
uS: ".S2X" is s=1 & x=1 { }
uM: ".M1" is s=0 & x=0 { }
uM: ".M2" is s=1 & x=0 { }
uM: ".M1X" is s=0 & x=1 { }
uM: ".M2X" is s=1 & x=1 { }
uD: ".D1" is s=0 & x=0 { }
uD: ".D2" is s=1 & x=0 { }
uD: ".D1X" is s=0 & x=1 { }
uD: ".D2X" is s=1 & x=1 { }

# units of forms where bit 12 is not the cross path bit
uSn: ".S1" is s=0 { }
uSn: ".S2" is s=1 { }
uLn: ".L1" is s=0 { }
uLn: ".L2" is s=1 { }
uDn: ".D1" is s=0 { }
uDn: ".D2" is s=1 { }

# .D unit (y) and data path (s) of loads and stores
uDT: ".D1T1" is y=0 & s=0 { }
uDT: ".D1T2" is y=0 & s=1 { }
uDT: ".D2T1" is y=1 & s=0 { }
uDT: ".D2T2" is y=1 & s=1 { }
uD2T: ".D2T1" is s=0 { }
uD2T: ".D2T2" is s=1 { }

# registers on the unit's side (r1, r2, rd), on the other side through the
# cross path when x is set (xr1, xr2), and register pairs (p1, p2, xp2, pd)
r1: s1A is s=0 & s1A { export s1A; }
r1: s1B is s=1 & s1B { export s1B; }
xr1: s1A is s=0 & x=0 & s1A { export s1A; }
xr1: s1B is s=0 & x=1 & s1B { export s1B; }
xr1: s1B is s=1 & x=0 & s1B { export s1B; }
xr1: s1A is s=1 & x=1 & s1A { export s1A; }
xp1: s1pAn is s=0 & x=0 & s1pAn & s1pA { export s1pA; }
xp1: s1pBn is s=0 & x=1 & s1pBn & s1pB { export s1pB; }
xp1: s1pBn is s=1 & x=0 & s1pBn & s1pB { export s1pB; }
xp1: s1pAn is s=1 & x=1 & s1pAn & s1pA { export s1pA; }
r2: s2A is s=0 & s2A { export s2A; }
r2: s2B is s=1 & s2B { export s2B; }
xr2: s2A is s=0 & x=0 & s2A { export s2A; }
xr2: s2B is s=0 & x=1 & s2B { export s2B; }
xr2: s2B is s=1 & x=0 & s2B { export s2B; }
xr2: s2A is s=1 & x=1 & s2A { export s2A; }
rd: dA is s=0 & dA { export dA; }
rd: dB is s=1 & dB { export dB; }

p1: s1pAn is s=0 & s1pAn & s1pA { export s1pA; }
p1: s1pBn is s=1 & s1pBn & s1pB { export s1pB; }
p2: s2pAn is s=0 & s2pAn & s2pA { export s2pA; }
p2: s2pBn is s=1 & s2pBn & s2pB { export s2pB; }
xp2: s2pAn is s=0 & x=0 & s2pAn & s2pA { export s2pA; }
xp2: s2pBn is s=0 & x=1 & s2pBn & s2pB { export s2pB; }
xp2: s2pBn is s=1 & x=0 & s2pBn & s2pB { export s2pB; }
xp2: s2pAn is s=1 & x=1 & s2pAn & s2pA { export s2pA; }
pd: dpAn is s=0 & dpAn & dpA { export dpA; }
pd: dpBn is s=1 & dpBn & dpB { export dpB; }

# constants
sc5: scst5 is scst5 { export *[const]:4 scst5; }
uc5: ucst5 is ucst5 { export *[const]:4 ucst5; }

# load/store base and offset registers on the .D unit's side
yb: s2A is y=0 & s2A { export s2A; }
yb: s2B is y=1 & s2B { export s2B; }
yo: s1A is y=0 & s1A { export s1A; }
yo: s1B is y=1 & s1B { export s1B; }

# load/store offset, scaled by the access size unless shown in parentheses
moff: "["^ucst5^"]" is b11=0 & paren=0 & ucst5 & asz { local o:4 = ucst5 << asz; export o; }
moff: "("^ucst5^")" is b11=0 & paren=1 & ucst5 { export *[const]:4 ucst5; }
moff: "["^yo^"]" is b11=1 & paren=0 & yo & asz { local o:4 = yo << asz; export o; }
moff: "("^yo^")" is b11=1 & paren=1 & yo { export yo; }

# load/store address
ma: "*-"^yb^moff is b12=0 & b9_10=0 & yb & moff { local ea:4 = yb - moff; export ea; }
ma: "*+"^yb^moff is b12=0 & b9_10=1 & yb & moff { local ea:4 = yb + moff; export ea; }
ma: "*--"^yb^moff is b12=1 & b9_10=0 & yb & moff { yb = yb - moff; local ea:4 = yb; export ea; }
ma: "*++"^yb^moff is b12=1 & b9_10=1 & yb & moff { yb = yb + moff; local ea:4 = yb; export ea; }
ma: "*"^yb^"--"^moff is b12=1 & b9_10=2 & yb & moff { local ea:4 = yb; yb = yb - moff; export ea; }
ma: "*"^yb^"++"^moff is b12=1 & b9_10=3 & yb & moff { local ea:4 = yb; yb = yb + moff; export ea; }

# 15-bit offset from B14 or B15
ma15: "*+B14["^ucst15^"]" is y=0 & ucst15 & asz { local ea:4 = B14 + (ucst15 << asz); export ea; }
ma15: "*+B15["^ucst15^"]" is y=1 & ucst15 & asz { local ea:4 = B15 + (ucst15 << asz); export ea; }

# branch targets, relative to the fetch packet
pcrel21: dest is scst21 [ dest = (inst_start & 0xffffffe0) + (scst21 << 2); ] { export *[ram]:4 dest; }
pcrel12: dest is fph=0 & cst12 [ dest = (inst_start & 0xffffffe0) + (cst12 << 2); ] { export *[ram]:4 dest; }
pcrel12: dest is fph=1 & cst12 [ dest = (inst_start & 0xffffffe0) + (cst12 << 1); ] { export *[ram]:4 dest; }
pcrel10: dest is cst10 [ dest = (inst_start & 0xffffffe0) + (cst10 << 2); ] { export *[ram]:4 dest; }
pcrel7: dest is cst7 [ dest = (inst_start & 0xffffffe0) + (cst7 << 2); ] { export *[const]:4 dest; }


################################################################
# Shared semantics
################################################################

# 40-bit long results go to the low 40 bits of a register pair
macro long40(dst, v) {
	dst = zext(v:5);
}

# SPKERNEL fstg,fcyc: the 6-bit field holds the stage from the top, bit
# reversed, and the cycle from the bottom; how many bits each gets depends on
# the ii of the SPLOOP (SPRUFE8B table 3-29)
spkd: stg^","^cyc is spii=0 & spkv [ stg = ((spkv >> 5) & 1) | (((spkv >> 4) & 1) << 1) | (((spkv >> 3) & 1) << 2) | (((spkv >> 2) & 1) << 3) | (((spkv >> 1) & 1) << 4) | ((spkv & 1) << 5); cyc = 0; ] { export *[const]:1 spkv; }
spkd: stg^","^cyc is spii=1 & spkv [ stg = ((spkv >> 5) & 1) | (((spkv >> 4) & 1) << 1) | (((spkv >> 3) & 1) << 2) | (((spkv >> 2) & 1) << 3) | (((spkv >> 1) & 1) << 4); cyc = spkv & 1; ] { export *[const]:1 spkv; }
spkd: stg^","^cyc is spii>1 & spii<4 & spkv [ stg = ((spkv >> 5) & 1) | (((spkv >> 4) & 1) << 1) | (((spkv >> 3) & 1) << 2) | (((spkv >> 2) & 1) << 3); cyc = spkv & 3; ] { export *[const]:1 spkv; }
spkd: stg^","^cyc is spii>3 & spii<8 & spkv [ stg = ((spkv >> 5) & 1) | (((spkv >> 4) & 1) << 1) | (((spkv >> 3) & 1) << 2); cyc = spkv & 7; ] { export *[const]:1 spkv; }
spkd: stg^","^cyc is spii>7 & spkv [ stg = ((spkv >> 5) & 1) | (((spkv >> 4) & 1) << 1); cyc = spkv & 15; ] { export *[const]:1 spkv; }

# SPMASK unit list, set by the SPMASK constructors
spml: spmvn is spmvn & spmv { export *[const]:1 spmv; }

# opcode spaces of the 32-bit instructions
@define LU  "b2_4=6"
@define SU  "b2_5=0x8"
@define SXU "b2_5=0xc & b11=1 & b10=1"
@define MU  "b2_6=0x00"
@define MXU "b2_5=0xc & b11=0"
@define DXU "b2_5=0xc & b11=1 & b10=0"

macro setSat() {
	CSR = CSR | 0x200;
}


################################################################
# Instruction structure
################################################################

# The root works out where the instruction sits in its fetch packet, the
# stage decodes it as a 32-bit or compact instruction or as the header, and
# fire, which resolves last, does the delay slot bookkeeping.

calc: is epsilon [ rem = dcnt - 1 - epx; ] { }

@define CARRY "globalset(inst_next, dcnt); globalset(inst_next, dtgt); globalset(inst_next, dkind); globalset(inst_next, dcall); globalset(inst_next, epx);"

ftgt: dtgt is dtgt { export *[ram]:4 dtgt; }

fx: is dkind=$(DK_JUMP) & dcall=0 & ftgt { goto ftgt; }
fx: is dkind=$(DK_JUMP) & dcall=1 & ftgt { call ftgt; }
fx: is dkind=$(DK_JUMP_C) & dcall=0 & ftgt { if (BRC != 0) goto ftgt; }
fx: is dkind=$(DK_JUMP_C) & dcall=1 & ftgt { if (BRC == 0) goto inst_next; call ftgt; }
fx: is dkind=$(DK_JUMPR) & dcall=0 { goto [BRT]; }
fx: is dkind=$(DK_JUMPR) & dcall=1 { call [BRT]; }
fx: is dkind=$(DK_JUMPR_C) & dcall=0 { if (BRC == 0) goto inst_next; goto [BRT]; }
fx: is dkind=$(DK_JUMPR_C) & dcall=1 { if (BRC == 0) goto inst_next; call [BRT]; }
fx: is dkind=$(DK_RET) & dcall=0 { return [BRT]; }
fx: is dkind=$(DK_RET) & dcall=1 { call [BRT]; }
fx: is dkind=$(DK_RET_C) & dcall=0 { if (BRC == 0) goto inst_next; return [BRT]; }
fx: is dkind=$(DK_RET_C) & dcall=1 { if (BRC == 0) goto inst_next; call [BRT]; }
fx: is dkind=$(DK_CALLP_A3) & ftgt { A3 = inst_next; call ftgt; }
fx: is dkind=$(DK_CALLP_B3) & ftgt { B3 = inst_next; call ftgt; }

fire: is dcnt=0 { }
fire: is dcnt!=0 & ishdr=1 [ $(CARRY) ] { }
fire: is dcnt!=0 & ishdr=0 & pb=1 [ $(CARRY) ] { }
fire: is dcnt!=0 & ishdr=0 & pb=0 & rem>0 & rem<16 [ dcnt = rem; epx = 0; $(CARRY) ] { }
fire: fx is dcnt!=0 & ishdr=0 & pb=0 & (rem=0 | rem>15) & fx { build fx; }

# fetch packet header word
fphead: ".fphead" hprot^", "^hrs^", "^hdw^", "^hdsz^", "^hbr^", "^hsat^", "^hl6^hl5^hl4^hl3^hl2^hl1^hl0^"b"
	is hmagic=0xe & hprot & hrs & hdw & hdsz & hbr & hsat & hl6 & hl5 & hl4 & hl3 & hl2 & hl1 & hl0 { }
